#GWS page layout

#Defaults options for all selections for all sections:
#[ITEMSPERROW] 3
#[QUERYSTRPAIRS] {'SYSTEMS':'gws','LEGEND':'Inside', 'GRIDLINES':'checked', 'SKIPACTION':'True'}
#This below is used to control whether each section should have its own html table. 
#[SUBTABLE] False

#[SECTION] [MK] Weather Data  
ws:cfTemp       # Temperature
ws:cfPress      # Pressure
ws:cfWindSpeed  # Wind Speed 
ws:cfWindDir    # Wind Direction
ws:wsDew        # Dew Point
#[QUERYSTRPAIRS] {'YMIN':0, 'YMAX':100}
ws:cfHumid      # Humidity
#[QUERYSTRPAIRS] {'YMIN':'',  'YMAX':''}
ws:tpPmPxChan(1|2)      #  Dust monitor (.3u and user defined)

#[SECTION] [CP]  Weather Data  
ws:..Temp       # Temperature
ws:..Press      # Pressure
ws:..WindSpeed  # Wind Speed 
ws:..WindDir    # Wind Direction
ws:..Dew        # Dew Point
#[QUERYSTRPAIRS] {'YMIN':0, 'YMAX':100}
ws:..Humid      # Humidity

ws:dimmFwhm		# Dimm_seeing
ws:dimmMeanFlux		# Dimm_flux
ws:irmaPwv		# Irma_pwv
ws:tpAtMtMx		# Truss_air1
ws:tpAtMtPx		# Trus_air2

#[ITEMSPERROW] 3
#[QUERYSTRPAIRS] {'SYSTEMS':'wfs','LEGEND':'Inside', 'GRIDLINES':'checked', 'SKIPACTION':'True'}
#This below is used to control whether each section should have its own html table. 
#[SUBTABLE] False

pwfs2:dc:fgDiag1P2.VALQ	# P2_count
pwfs2:dc:seeing		# P2_seeing
oiwfs:dc:fgDiag1P2.VALQ	# Oiwfs_counts
oiwfs:dc:seeing		# Oiwfs_seeing
