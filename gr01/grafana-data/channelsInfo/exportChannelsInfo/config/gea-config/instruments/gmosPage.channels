gm:cc:grDownValve

#[SECTION] Zero Point Corrections
#[SUBTABLE] True
#[ITEMSPERROW] 1
#[QUERYSTRPAIRS] {'FORMAT':'Spreadsheet'}
gm:cc:grConfigZpcGRA|gm:gratingSelect.ZRST   #      gm:cc:grConfigZpcGRA   and   gm:gratingSelect.ZRST
gm:cc:grConfigZpcGRB|gm:gratingSelect.ONST     #      gm:cc:grConfigZpcGRB   and   gm:gratingSelect.ONST
gm:cc:grConfigZpcGRC|gm:gratingSelect.TWST     #      gm:cc:grConfigZpcGRC   and   gm:gratingSelect.TWST
gm:cc:grConfigZpcGRD|gm:gratingSelect.THST   #      gm:cc:grConfigZpcGRD   and   gm:gratingSelect.THST

#[SECTION] DTA Positions
#[SUBTABLE] True
#[ITEMSPERROW] 3
gm:cc:dta1Device.MPOS           # X Current 
gm:cc:dta1Device.VAL           # X Device Target 
gm:cc:dtaAssembly.A              # X Target 
gm:cc:dta2Device.MPOS           # Y Current 
gm:cc:dta2Device.VAL           # Y Device Target 
gm:cc:dtaAssembly.B          # Y Target 
gm:cc:dta3Device.MPOS       # Z Current 
gm:cc:dta3Device.VAL           # Z Device Target 
gm:cc:dtaAssembly.C             # Z Target 
gm:dtaTrack:dtaTrack.VALA       # X Total Demand
gm:dtaTrack:dtaTrack.VALB       # Y Total Demand
gm:dtaTrack:dtaTrack.VALC       # Z Total Demand
gm:cc:dta1Device.PWR            # X Motor Power
gm:cc:dta2Device.PWR            # Y Motor Power
gm:cc:dta3Device.PWR            # Z Motor Power
#[QUERYSTRPAIRS] {'FORMAT':'Spreadsheet'}
gm:cc:dtaAssembly.(BUS1|BUS2|BUS3)
#[SECTION]  Other
#[SUBTABLE] True
#[ITEMSPERROW] 1

#[QUERYSTRPAIRS] {'FORMAT':'Spreadsheet'}
gm:fltPos.B                # Filter wheel # 2  (Spreadsheet)
gm:dtaTrack.D               # Focus (z) offset (Spreadsheet)
gm:cc:mskAssembly.SIN      # Ignore Barcode Reader Failure (Spreadsheet)

#[SECTION]  Filter wheels
#[SUBTABLE] True
#[ITEMSPERROW] 3
gm:cc:flt1Device.MPOS # Filter wheel # 1 position
gm:cc:flt1Device.VAL # Filter wheel # 1  target position
gm:fltPos.A {'FORMAT':'Spreadsheet'} # Filter wheel # 1  (Spreadsheet)

gm:cc:flt2Device.MPOS # Filter wheel # 2 position
gm:cc:flt2Device.VAL # Filter wheel # 2  target position
gm:fltPos.B {'FORMAT':'Spreadsheet'} # Filter wheel # 2  (Spreadsheet)

#[SECTION] Nod & Shuffle
#[SUBTABLE] True
#[ITEMSPERROW] 4
gm:dc:dcSetup.F {'FORMAT':'Spreadsheet'} # Input state
gm:dc:dcSetup.VALF {'FORMAT':'Spreadsheet'} # Validated state
gm:sad:dc:nsState {'FORMAT':'Spreadsheet'} # State in SAD
gm:dc:dcSetup.F|gm:dc:dcSetup.VALF|gm:sad:dc:nsState {'FORMAT':'Spreadsheet'} # All states
gm:sad:dc:AExpCount	# A count
gm:sad:dc:BExpCount	# B count
gm:sad:dc:(AExpCount|BExpCount)	# A & B count

