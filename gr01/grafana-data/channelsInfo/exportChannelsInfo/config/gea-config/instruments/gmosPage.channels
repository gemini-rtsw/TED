#Gmos page layout

#Defaults options for all selections for all sections:
#[ITEMSPERROW] 2
#[QUERYSTRPAIRS] {'SYSTEMS':'gmos','LEGEND':'Inside', 'GRIDLINES':'checked'}
#This below is used to control whether each section should have its own html table. 
#[SUBTABLE] False

#[SECTION] Temperature
#[ITEMSPERROW] 1
#[SUBTABLE] True
#[AUTOTITLE] False
gm:sad:dc:detTemp      # Detector 

gm:dc:ls336:IN1         # Flexure Temperature (C)
gm:dc:ls336:IN2         # CCDb Temperature (C)
gm:dc:ls336:IN3         # CCDg Temperature (C)
gm:dc:ls336:IN4         # CCDr Temperature (C)
gm:dc:ls336:OUT1:SP_RBV # Setpoint Temperature (C)
gm:dc:ls336:P1_RBV      # Lakeshore P gain
gm:dc:ls336:I1_RBV      # Lakeshore I gain
gm:dc:ls336:D1_RBV      # Lakeshore D gain
gm:dc:ls336:HTR1        # Lakeshore Heater Power (%)
gm:dc:ls336:OnRamp1_RBV # Lakeshore Ramp

gm:cc:temp1.VAL    # WFS CCD controller case  (temp1)
gm:cc:temp2.VAL    # Collimator Case  (temp2)
gm:cc:temp3.VAL    # Electronics Enclosure 2  (temp3)
gm:cc:temp4.VAL    # Filter Assembly  (temp4)
gm:cc:temp5.VAL    # Collimator Beam Air  (temp5)
gm:cc:temp6.VAL    # SCI CCD controller case   (temp6)
gm:cc:temp7.VAL    # Electronics Enclosure 1  (temp7)
gm:cc:temp8.VAL    # Camera Barrel Midpoint (temp8)
#[CELL]
gm:cc:temp(1|6|7|8)      {'LEGEND':'Outside'}   # Selected CC (temp1,  temp6, temp7, temp8)
gm:cc:temp.     {'LEGEND':'Outside'}     # All CC  

#[SECTION] Sequencer (Spreadsheet - Last hour)
#[QUERYSTRPAIRS] {'FORMAT':'Spreadsheet', 'LAPSE':60}
gm:(s[^a]|[^s])      # All

#[SECTION] DC setup (Spreadsheet)
#[QUERYSTRPAIRS] {'FORMAT':'Spreadsheet'}
gm:dc:dcSetup.*

#[SECTION] Masks 
#[SUBTABLE] True
#[ITEMSPERROW] 1
#[QUERYSTRPAIRS] {'FORMAT':'Spreadsheet'}
gm:cc:mskNotAligned
gm:cc:mskNotInSlot   # gm:cc:mskNotInSlot (Testing...)
gm:cc:mskNotCassette
gm:cc:optsensorEnable
gm:cc:mskIfuNotIn
gm:cc:mskNotInFp
gm:cc:mskMaskNotIn 
gm:cc:mskGrpNotGripped
gm:cc:mskGrpNotReleased
gm:cc:mskGrpPower
#[CELL]
#[QUERYSTRPAIRS] {'FORMAT':'Plot'}
gm:cc:mskGrpDevice.MPOS 
gm:cc:mskGrpDevice.VAL 
gm:cc:mskExtDevice.VAL 
gm:cc:mskExtDevice.MPOS  
gm:cc:mskCasDevice.VAL 
gm:cc:mskCasDevice.MPOS 
gm:cc:mskCasDevice.RRBV
gm:cc:mskRelDevice.VAL 
gm:cc:mskRelDevice.MPOS  
gm:cc:msk.*  {'LAPSE':60} # All above (Last hour)
gm:cc:mskSwitchWord.VALA # Mask switch Status Word 
gm:cc:mskSwitchWord.VALB # released, locked or in between
gm:cc:mskSwitchWord.VALC # gripped, released or between
gm:cc:mskSwitchWord.VALD # Mask, IFU or neither in FP
gm:cc:mskNotInFp.VAL # Not In focal plane
gm:cc:mskMaskNotIn.VAL # Not Mask In
gm:cc:mskIfuNotIn.VAL # Not Ifu In
gm:cc:mskSwitchWord.H # Mask Not In Focal Plane (INPUT)
gm:cc:mskSwitchWord.I # IFU Not In Focal Plane (INPUT)
gm:cc:mskSwitchWord.J # Not In Focal Plane (INPUT)
#[CELL]
gm:cc:mskExtDevice.(PWR|PSTA) # mskExt Power and Power Status
gm:cc:mskCasDevice.(PWR|PSTA) # mskCas Power and Power Status
gm:cc:mskGrpDevice.(PWR|PSTA) # mskGrp Power and Power Status
gm:cc:mskRelDevice.(PWR|PSTA) # mskRel Power and Power Status
gm:cc:mskRelDevice.MPOS # mskRel Position
gm:cc:mskRelNotLocked.VAL # mskRel Lock
#[CELL]
gm:cc:mskLvdt {'LAPSE':60, 'FORMAT':'Plot'} # gm:cc:mskLvdt (Plot)

#[SECTION] Gmos Oiwfs  
