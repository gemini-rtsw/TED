#[CELL] 
gm:wfs:probeSinBas
gm:wfs:probeCosBas
gm:wfs:probeSinPko
gm:wfs:probeCosPko
gm:wfs:probeAbsAngles.VALA
gm:wfs:probeAbsAngles.VALB
gm:wfs:probeAbsAngles.VALC
gm:wfs:probeAbsAngles.VALD
gm:wfs:probeAbsX
gm:wfs:probeAbsY
gm:wfs:probeCurX
gm:wfs:probeCurY
gm:wfs:probeX
gm:wfs:probeY
