gm:wfs:probePkoDevice.RENC      # PickOff Raw Encoder
gm:wfs:probePkoDevice.MESS   {'FORMAT':'Spreadsheet'}   # PickOff Error Message

#[SECTION] Gratings (Spreadsheet)
#[SUBTABLE] True
