gm:wfs:probePkoDevice.MPOS 
gm:wfs:probeBasDevice.VAL    # gm:wfs:probeBasDevice.VAL  (Base demand)
gm:wfs:probePkoDevice.VAL   # gm:wfs:probePkoDevice.VAL   (Pickoff demand) 
gm:wfs:probeBasCalcEncErr.VAL  # probeBasCalcEncErr.VAL (Base enc. err.)
gm:wfs:probePkoCalcEncErr.VAL  # probePkoCalcEncErr.VAL (Pickoff enc. err.)
gm:wfs:probeBasDevice.BRK 
gm:wfs:probeBasDevice.BSTA
gm:wfs:probeBasDevice.PWR
gm:wfs:probePkoDevice.BRK
gm:wfs:probePkoDevice.BSTA
gm:wfs:probePkoDevice.PWR
gm:wfs:inPosition # gm:wfs:inPosition (In-position flag)
gm:wfs:followA.H # gm:wfs:followA.H (Following mode) 
gm:wfs:followA.VALC # Follow Track ID

#[QUERYSTRPAIRS] {'LAPSE':60}
gm:wfs:probe*  # All (Last hour)

#[CELL] 
#[CELL] 

#[CELL] Demanded pos in Tel. Coord:
#[CELL] 
gm:wfs:followA.A   # 	X_T
gm:wfs:followA.B   # 	Y_T
#[CELL] Demanded pos in Mask Coord:
#[CELL]
gm:wfs:followA.VALE #  X_M
gm:wfs:followA.VALF #  Y_M
#[CELL] Probe Offsets
#[CELL]
gm:wfs:probeOffset.VALE # track ID
gm:wfs:probeOffset.VALA # X Offset (mm)
gm:wfs:probeOffset.VALB # Y Offset (mm)
gm:wfs:probeOffset.VALC # Z Offset (mm)
gm:wfs:probeOffset.VALD # Angle Offset (rad)

#[SECTION] GMOS OIWFS Base
#[SUBTABLE] True
#[ITEMSPERROW] 3
#[QUERYSTRPAIRS] {'FORMAT':'Plot'}
gm:wfs:probeBasDevice.RRBV      # Base Raw Motor
gm:wfs:probeBasDevice.RENC      # Base Raw Encoder
gm:wfs:probeBasDevice.MESS  {'FORMAT':'Spreadsheet'}    # Base Error Message

#[SECTION] GMOS OIWFS PickOff
