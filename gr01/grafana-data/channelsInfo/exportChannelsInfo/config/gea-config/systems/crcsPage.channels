#CRCS page layout

#Defaults options for all selections for all sections:
#[ITEMSPERROW] 1
#[QUERYSTRPAIRS] {'SYSTEMS':'crcs','LEGEND':'Inside', 'GRIDLINES':'checked'}
#This below is used to control whether each section should have its own html table. 
#[SUBTABLE] False

#[SECTION] Angles  
#[QUERYSTRPAIRS] {'LAPSE':180}
cr:crCurrentVel 					# Velocity
cr:crCurrentPos                     # Current angle
cr:crDemandPos                  # CRCS Demand Pos.
cr:crPmacDemandPos           # CRCS Pmac Demand Pos.
cr:crPmacPosError                # CRCS PMAC Following Error
cr:crCWP:PmacPosError       # CRCS WRAP PMAC Following Error
cr:crCurrentPos|tcs:demandRma   {'SYSTEMS':'tcs crcs', 'LAPSE': 'lastNight'}  # TCS Dem & Act Pos 

#[SECTION] Other  
#[QUERYSTRPAIRS] {'FORMAT':'Spreadsheet'}
cr:crStateS  # cr:crStateS (Spreadsheet)
cr:crCommandS  # cr:crCommandS (Spreadsheet)
cr:health.OMSS  # cr:health.OMSS (Spreadsheet)

#[SECTION]  IOC Stats
#[CSSCLASS] sectionMain
#[ITEMSPERROW] 4
#[SUBTABLE] True

cr:iocStats:SUSP_TASK_CNT       # Susp Tasks
cr:iocStats:MEM_FREE            # Free memory
cr:iocStats:LOAD                # Global load
cr:iocStats:UPTIME {'FORMAT':'Spreadsheet'} # Uptime

cr:iocStats:GTIM_ERR_CNT        # Time errors
cr:iocStats:SYS_MBUF_FREE       # Free Sys MBUFs
cr:iocStats:SYS_CLUST_AVAIL_(0|1)   # % Clust available
cr:iocStats:CA_CONN_CNT         # CA Connections

cr:iocStats:IF(I|O)_ERR_CNT     # IF errors
cr:iocStats:FD_FREE             # Free FDs
cr:iocStats:APP_DIR(1|2) {'FORMAT':'Spreadsheet'} # Boot version 
cr:iocStats:CA_CLNT_CNT         # CA Clients


