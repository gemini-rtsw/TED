#[QUERYSTRPAIRS] {'FORMAT':'Spreadsheet'}
ag:hwEng.A	  				# HRWFS Move to eng. Pos.(Spreadsheet)

#[SECTION]  IOC Stats
#[CSSCLASS] sectionMain
#[ITEMSPERROW] 4
#[SUBTABLE] True

ag:iocStats:SUSP_TASK_CNT       # Susp Tasks
ag:iocStats:MEM_FREE            # Free memory
ag:iocStats:LOAD                # Global load
ag:iocStats:UPTIME {'FORMAT':'Spreadsheet'} # Uptime

ag:iocStats:GTIM_ERR_CNT        # Time errors
ag:iocStats:SYS_MBUF_FREE       # Free Sys MBUFs
ag:iocStats:SYS_CLUST_AVAIL_(0|1)   # % Clust available
ag:iocStats:CA_CONN_CNT         # CA Connections

ag:iocStats:IF(I|O)_ERR_CNT     # IF errors
ag:iocStats:FD_FREE             # Free FDs
ag:iocStats:APP_DIR(1|2) {'FORMAT':'Spreadsheet'} # Boot version 
ag:iocStats:CA_CLNT_CNT         # CA Clients

