# A&G page layout

# Defaults for all sections:
#By default only look at the last 6 hours (LAPSE parameter).
#[QUERYSTRPAIRS] {'SYSTEMS':'ag','GRIDLINES':'on','LEGEND':'Inside', 'LAPSE':360}
#[ITEMSPERROW] 2
#This below is used to control whether each section should have its own html table. 
#[SUBTABLE] False

#[SECTION] Science Fold 
#[ITEMSPERROW] 3
#[SUBTABLE] True
#[QUERYSTRPAIRS] {'FORMAT':'Plot'}
ag:sfEngPosA.VALA   	#   Eng Pos A
ag:sfEngPosA.VALB   	#   Eng Pos B
ag:sfEngPosA.VALC   	#   Eng Pos C
ag:sfPosA.VALA  # Pos RT (deg)
ag:sfPosA.VALB  # Pos tilt (deg)
ag:sfPosA.VALC  # Pos linear stage (mm)
#[QUERYSTRPAIRS] {'FORMAT':'Spreadsheet'}
ag:sfName.VAL
ag:sfxlat.VALA
#[QUERYSTRPAIRS] {'FORMAT':'Plot'}
ag:RT2PosA.VALA
#[QUERYSTRPAIRS] {'FORMAT':'Spreadsheet'}
ag:RT2xlat.VALI
ag:RT2xlat.VALG
#[QUERYSTRPAIRS] {'FORMAT':'Plot'}
ag:TiltPosA.VALA
#[QUERYSTRPAIRS] {'FORMAT':'Spreadsheet'}
ag:Tiltxlat.VALI
ag:Tiltxlat.VALG
#[QUERYSTRPAIRS] {'FORMAT':'Plot'}
ag:Lin2PosA.VALA
#[QUERYSTRPAIRS] {'FORMAT':'Spreadsheet'}
ag:Lin2xlat.VALI
ag:Lin2xlat.VALG
ag:Lin2xlat.VALA
ag:Tiltxlat.VALA
ag:RT2xlat.VALA

#[SECTION] HRWFS General
#[ITEMSPERROW] 2
#[SUBTABLE] True
#[QUERYSTRPAIRS] {'FORMAT':'Plot'}


ag:hwMove.A     {'FORMAT':'Spreadsheet'}    # Real Pos Demand (ag:hwMove.A)
ag:hwEng.A     {'FORMAT':'Spreadsheet'}      # Eng Pos Demand (ag:hwEng.A)
ag:hwSel.A  {'FORMAT':'Spreadsheet'}  # Selected Pos Demand (ag:hwSel.A)
#[CELL]

#[CELL]
#[CELL]

ag:hwParked.VAL  # HR Parked flag (ag:hwParked.VAL )
#[CELL]

#[CELL]
#[CELL]

ag:hwPosA.VALA     
ag:hwEngPosA.VALA  
ag:hwxlat.VALG 
ag:hwxlat.VALI 
ag:hwxlat.VALA {'FORMAT':'Spreadsheet'}

#[CELL]
hrwfs:encoderMode {'FORMAT':'Spreadsheet'} # Encoder Mode
hrwfs:encoderStatusStr {'FORMAT':'Spreadsheet'} # Encoder Switch

#[SECTION] HRWFS Mechanisms
#[ITEMSPERROW] 4
#[SUBTABLE] True
#[QUERYSTRPAIRS] {'FORMAT':'Plot'}

#[CELL]
#[CELL] Eng Position
#[CELL] Position
#[CELL] Name (Spreadsheet)

#[CELL] Focus
hrwfs:focusEngPosA.VALA 
hrwfs:focusPosA.VALA 
hrwfs:focusName.VAL  {'FORMAT':'Spreadsheet'}
#[CELL] Lens
hrwfs:lensEngPosA.VALA 
hrwfs:lensPosA.VALA 
hrwfs:lensName.VAL  {'FORMAT':'Spreadsheet'}
#[CELL] CLFilter
hrwfs:clfilterEngPosA.VALA 
hrwfs:clfilterPosA.VALA 
hrwfs:clfilterName.VAL   {'FORMAT':'Spreadsheet'}
#[CELL] NDFilter
hrwfs:ndfilterEngPosA.VALA 
hrwfs:ndfilterPosA.VALA 
hrwfs:ndfilterName.VAL  {'FORMAT':'Spreadsheet'}
#[CELL] Fldstop
hrwfs:fldstopEngPosA.VALA 
hrwfs:fldstopPosA.VALA 
hrwfs:fldstopName.VAL   {'FORMAT':'Spreadsheet'} 

