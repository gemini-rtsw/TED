#ECS page layout

#Defaults options for all selections for all sections:
#[ITEMSPERROW] 3
#This below is used to control whether each section should have its own html table.
#[SUBTABLE] False
#[QUERYSTRPAIRS] {'SYSTEMS':'ecs','LEGEND':'Inside','GRIDLINES':'checked'}

#[SECTION] Top Shutter
ec:moveShtrs.VALB			                # Demand
ec:topShtrPos				                    # Position
ec:(moveShtrs.VALB|topShtrPos)		# Demand and Position
ec:topShtrErr				                    # Error
#[CELL]
#[CELL]
#[CELL]
#[CELL]
#[CELL]
ec:sh:t1.				                      # Drive Currents
ec:sh:tsum                                  # Current Sum
ec:sh:t(1.|sum)                             # Drive Currents and Sum
ec:sh:tleft                                    #Left
ec:sh:tright                                    #Right
ec:sh:t(left|right)                           #Left and Right
ec:sh:ttop                                     # Top
ec:sh:tbottom                              # Bottom
ec:sh:t(top|bottom)                      #Top and Bottom

#[SECTION] Bottom Shutter
ec:moveShtrs.VALD		                    #	Demand
ec:botShtrPos			                        #	Position
ec:(moveShtrs.VALD|botShtrPos)	    #	Demand and Position
ec:botShtrErr			                        #	Error
ec:botShtrSkew			                    #	Skew
ec:botShtrSkewEnc		                    #	Skew encoder
ec:bsBrk2(x|y|z|w)	                            # Brake Currents
#[CELL]
#[CELL]
#[CELL]
#[CELL]
#[CELL]
ec:sh:b2.				                       # Drive Currents
ec:sh:bsum                                  # Current Sum
ec:sh:b(1.|sum)                            # Drive Currents and Sum
ec:sh:bleft                                   #Left
ec:sh:bright                                 #Right
ec:sh:b(left|right)                         #Left and Right
ec:sh:btop                                   # Top
ec:sh:bbottom                             # Bottom
ec:sh:b(top|bottom)                     #Top and Bottom

#[SECTION] Dome
#[ITEMSPERROW] 4
#[SUBTABLE] True
ec:moveDome.VALB              	        # Demand
ec:domePos              	                    # Position
ec:(moveDome.VALB|domePos)       # Demand and Position
ec:domeErr              	                    # Error

#[SECTION] Vent Gates
ec:eastVentGatePos              	        # East
ec:westVentGatePos                          # West
ec:(east|west)VentGatePos             	# Both
ec:vg:evRPos  # East Right Pos 
ec:vg:evLPos  # East Left Pos
ec:vg:evSkew  # East Skew
ec:vg:wvRPos  # West Right Pos
ec:vg:wvLPos  # West Left Pos
ec:vg:wvSkew  # West Skew


#[SECTION] PLC
#[ITEMSPERROW] 2
#[SUBTABLE] True
ec:fault:plcHeartbeat              		# Heartbeat
#[QUERYSTRPAIRS] {'FORMAT':'Spreadsheet'}
ec:fault:word17:bits			            # Encoder faults (Spreadsheet)

#[SECTION] Dome Drive Currents 
#[ITEMSPERROW] 4
#[SUBTABLE] True
#[QUERYSTRPAIRS] {'LAPSE':180}
ec:dc:d3x    #  Drive 3X
ec:dc:d3y    #  Drive 3Y
ec:dc:d3z    #  Drive 3Z
ec:dc:d3w    #  Drive 3W
ec:dc:d3e    #  Drive 3E
ec:dc:d3f    #  Drive 3F
ec:dc:d3g    #  Drive 3G
ec:dc:d3h    #  Drive 3H
ec:dc:d3.    #  All drives

#[SECTION] Plant Room Chillers
#[ITEMSPERROW] 5
#[SUBTABLE] True
#[QUERYSTRPAIRS] {'LAPSE':180}
pr:ch:(c1to|c1ti)	                # Chiller 1
pr:ch:(c2to|c2ti)	                # Chiller 2
pr:ef:(tut|out)	               		 # Tunnel Temps
pr:ef:(ef2v|ef2c)	                # Current/Voltage
ec:prc3pi		                #[NA] Chiller 3 Return Pressure (psi)

#[SECTION] Vent Gate Currents
#[QUERYSTRPAIRS] {'LAPSE':30}
ec:vg:ev4.*	  # East
ec:vg:wv5.*	  # West

#[SECTION] [MK] AHUs Observing Floor  
#[ITEMSPERROW] 6
#[SUBTABLE] True

#[QUERYSTRPAIRS] {'FORMAT':'Plot'}
#[CELL] Temperature
ec:prah2t	 # AHU_2
ec:prah3t	 # AHU_3
ec:prah4t	 # AHU_4
ec:prah5t	 # AHU_5
ec:prah.t	 # All

#[QUERYSTRPAIRS] {'FORMAT':'Spreadsheet'}
#[CELL] Status (Text)
ec:prahuproc.VALA     #   AHU_2
ec:prahuproc.VALB     #   AHU_3
ec:prahuproc.VALC     #   AHU_4
ec:prahuproc.VALD     #   AHU_5
ec:prahuproc.VAL.     #   All

#[QUERYSTRPAIRS] {'FORMAT':'Plot'}
#[CELL] Status (Numerical)
ec:prahuproc.A         #  AHU_2 	      
ec:prahuproc.B	       #  AHU_3
ec:prahuproc.C	       #  AHU_4
ec:prahuproc.D	       #  AHU_5
ec:prahuproc.(A|B|C|D) #  All

#[QUERYSTRPAIRS] {'FORMAT':'Plot'}
#[CELL] AHU Manual Control (On/Off)
ec:prahuc(Startbit2|Stopbit3).PROC	     	   	    #  AHU_2 
ec:prahuc(Startbit4|Stopbit5).PROC	 	   	        #  AHU_3
ec:prahuc(Startbit6|Stopbit7).PROC	 	   	        #  AHU_4
ec:prahuc(Startbit8|Stopbit9).PROC	 	   	        #  AHU_5
ec:prahuc(Startbit(2|4|6|8)|Stopbit(3|5|7|9)).PROC	 #  All

#[CELL] AHUS Auto Sequence
#[QUERYSTRPAIRS] {'FORMAT':'Spreadsheet'}
ec:prahuproc.VALE			            # Status (Text)
#[QUERYSTRPAIRS] {'FORMAT':'Plot'}
ec:prahuproc.E				            # Status (Num)
ec:prahuc(Startbit0|Stopbit1).PROC	    # On/Off

#[SECTION] [MK] Observatory Electrical Power
#[CSSCLASS] sectionMain

#[SECTION] [MK]  Real Time Measurements 
#[ITEMSPERROW] 1
#[SUBTABLE] True
ec:elec:al(v|vab|vbc|vca).VAL	     #  Average Line Voltage
ec:elec:ap(v|van|vbn|vcn).VAL	     #  Average Phase Voltage
ec:elec:ap(c|ca|cb|cc).VAL	         #  Average Phase Current
ec:elec:kwt.VAL			             #  kW Total
ec:elec:kwt(a|b|c).VAL		         #  kW phase
ec:elec:kvt.VAL			             #  kVA Total
ec:elec:kvt(a|b|c).VAL		        # kVA phase
ec:elec:pf(t|pa|pb|pc).VAL	        #  Power factor (total and phases A,B,C)
ec:elec:freq.VAL		            #  Frequency on Va
				   
#[SECTION] [MK] MIN Real Time Measurements 
#[ITEMSPERROW] 1
#[SUBTABLE] True
ec:elec:mnal(v|vab|vbc|vca).VAL        #  Average Line Voltage
ec:elec:mnap(v|van|vbn|vcn).VAL        #  Average Phase Voltage
ec:elec:mnap(c|ca|cb|cc).VAL	       #  Average Phase Current
ec:elec:mnkwt.VAL		                #  kW Total
ec:elec:mnkwt(a|b|c).VAL	            #  kW phase
ec:elec:mnkvt.VAL		                #  kVA Total
ec:elec:mnkvt(a|b|c).VAL	            #  kVA phase
ec:elec:mnpf(t|pa|pb|pc).VAL	       #  Power factor (total and phases A,B,C)
ec:elec:mnfreq.VAL		                 #  Frequency on Va

#[SECTION] [MK] MAX Real Time Measurements 
#[ITEMSPERROW] 1
#[SUBTABLE] True
ec:elec:mxal(v|vab|vbc|vca).VAL        #  Average Line Voltage
ec:elec:mxap(v|van|vbn|vcn).VAL        #  Average Phase Voltage
ec:elec:mxap(c|ca|cb|cc).VAL	       #  Average Phase Current
ec:elec:mxkwt.VAL		                #  kW Total
ec:elec:mxkwt(a|b|c).VAL	             #  kW phase
ec:elec:mxkvt.VAL		                #  kVA Total
ec:elec:mxkvt(a|b|c).VAL	             #  kVA phase
ec:elec:mxpf(t|pa|pb|pc).VAL	       #  Power factor (tatal and phases A,B,C)
ec:elec:mxfreq.VAL		                #  Frequency on Va
				   
#[SECTION] [MK] Power Consumption (Spreadsheet)
#[ITEMSPERROW] 4
#[SUBTABLE] True
#[QUERYSTRPAIRS] {'FORMAT':'Spreadsheet'}
ec:elec:(g|m|k)wh.VAL	     	# kWh/MWh/GWh
ec:elec:kwh.VAL        		    # kWh
ec:elec:mwh.VAL        		    # MWh
ec:elec:gwh.VAL        		    # GWh
ec:elec:(g|m|k)varh.VAL	     	  # kVARh/MVARh/GVARh
ec:elec:kvarh.VAL		        # kVARh
ec:elec:mvarh.VAL		        # MVARh
ec:elec:gvarh.VAL		        # GVARh
ec:elec:(g|m|k)vah.VAL	     	  # kVAh/MVAh/GVAh
ec:elec:kvah.VAL		        # kVAh
ec:elec:mvah.VAL		        # MVAh
ec:elec:gvah.VAL		        # GVAh

#[SECTION] [MK] ECS mode
#[ITEMSPERROW] 5
#[SUBTABLE] True
ec:fault:word6:bits.B0 # OFF
ec:fault:word6:bits.B1 # ECS
ec:fault:word6:bits.B2 # PCU1
ec:fault:word6:bits.B3 # PCU2
ec:fault:word6:bits.B(0|1|2|3) # ALL

#[SECTION] [MK] Vent Gates motor overload
#[ITEMSPERROW] 5
#[SUBTABLE] True
ec:fault:word4:bits.BC # East-X
ec:fault:word4:bits.BD # East-Y
ec:fault:word4:bits.BE # East-Z
ec:fault:word4:bits.BF # East-W
ec:fault:word4:bits.B(C|D|E|F) # East-ALL

ec:fault:word5:bits.BC # West-X
ec:fault:word5:bits.BD # West-Y
ec:fault:word5:bits.BE # West-Z
ec:fault:word5:bits.BF # West-W
ec:fault:word5:bits.B(C|D|E|F) # West-ALL

#[SECTION] [CP] PLC Word  
#[ITEMSPERROW] 5
#[SUBTABLE] True

#[QUERYSTRPAIRS] {'FORMAT':'Spreadsheet'}
ec:domeDrvCtrlPLC	 # Carrousel
ec:topShtrDrvCtrlPLC     # Top Shutter
ec:botShtrDrvCtrlPLC     # Bottom Shutter
ec:eastVgateDrvCtrlPLC   # East Vent Gate
ec:westVgateDrvCtrlPLC   # West Vent Gate

#[SECTION] [CP] Drive Power Sequence Status
#[ITEMSPERROW] 4
#[QUERYSTRPAIRS] {'FORMAT':'Spreadsheet'}
ec:powSeq1proc.VALC     # Dome Power Sequence
ec:powSeq2proc.VALD     # Dome Power Command Sequence
ec:powSeq4proc.VALA     # Dome Auto Reset Sequence
ec:powSeq1proc.VALC|ec:powSeq2proc.VALD|ec:powSeq4proc.VALA  # All Dome Sequences

ec:powSeq1proc.VALA     # Top Shutter Power Sequence
ec:powSeq2proc.VALB     # Top Shutter Power Command Sequence
ec:powSeq3proc.VALC     # Top Shutter Auto Reset Sequence
ec:powSeq1proc.VALA|ec:powSeq2proc.VALB|ec:powSeq3proc.VALC  # All Top Shutter Sequences

ec:powSeq1proc.VALB     # Bottom Shutter Sequence
ec:powSeq2proc.VALC     # Bottom Shutter Power Command Sequence
ec:powSeq3proc.VALD     # Bottom Shutter Auto Reset Sequence
ec:powSeq1proc.VALB|ec:powSeq2proc.VALC|ec:powSeq3proc.VALD  # All Bottom Shutter Sequences

ec:powSeq1proc.VALD     # East Ventgate Power Sequence
ec:powSeq3proc.VALA     # East Ventgate Power Command Sequence
ec:powSeq4proc.VALB     # East Ventgate Auto Reset Sequence
ec:powSeq1proc.VALD|ec:powSeq3proc.VALA|ec:powSeq4proc.VALB  # All East Ventgate Sequences

ec:powSeq2proc.VALA     # West Ventgate Power Sequence
ec:powSeq3proc.VALB     # West Ventgate Power Command Sequence
ec:powSeq4proc.VALC     # West Ventgate Auto Reset Sequence
ec:powSeq2proc.VALA|ec:powSeq3proc.VALB|ec:powSeq4proc.VALC  # All West Ventgate Sequences

ec:powSeq1proc.VAL(A|B|C|D)|ec:powSeq2proc.VALA #All Power Sequences
ec:powSeq2proc.VAL(B|C|D)|ec:powSeq3proc.VAL(A|B) #All Power Command Sequences
ec:powSeq4proc.VAL(A|B|C)|ec:powSeq3proc.VAL(C|D) #All Auto Reset Sequences    

#[SECTION] [CP] Auto Close Sequence 
#[ITEMSPERROW] 3
#[QUERYSTRPAIRS] {'FORMAT':'Spreadsheet'}
ec:powSeq4proc.VALD     # Shutter
ec:powSeq5proc.VALA     # Top Shutter
ec:powSeq5proc.VALB     # Bottom Shutter       
ec:powSeq5proc.VALC     # East Vent Gate
ec:powSeq5proc.VALD     # West Vent Gate


