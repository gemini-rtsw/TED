# WFS page layout

# Defaults for all sections:
#[QUERYSTRPAIRS] {'SYSTEMS':'wfs','GRIDLINES':'on','LEGEND':'Inside','LAPSE':'lastNight'}
#[ITEMSPERROW] 2
#This below is used to control whether each section should have its own html table. 
#[SUBTABLE] False
#[AUTOTITLE] False

#[SECTION] Seeing Estimates
#[ITEMSPERROW] 3
#[SUBTABLE] True
#[QUERYSTRPAIRS] {'YMIN':0,'YMAX':2.5}
pwfs2:dc:seeing     # P2
oiwfs:dc:seeing      # OI
(p|oi)wfs(2|):dc:seeing   [FORMAT1]   # All

#[SECTION] Total Counts
#[ITEMSPERROW] 4
#[SUBTABLE] True
pwfs1:dc:fgDiag6P1.VALH  # P1
pwfs2:dc:fgDiag1P2.VALQ # P2
oiwfs:dc:fgDiag1P2.VALQ # OI
(p|oi)wfs(1|2):dc:fgDiag(1|6)(P1|P2|Oi).VAL(H|Q)  {'LEGEND':'Outside'} [FORMAT1]   # All

#[SECTION] Detector Temperatures
#[ITEMSPERROW] 4
#[SUBTABLE] True
pwfs1:dc:headTemp   # P1
pwfs2:dc:headTemp   # P2
oiwfs:dc:headTemp [CP]   # OI
hrwfs:dc:headTemp   # HR
((p|hr)wfs(|1|2)|oiwfs):dc.headTemp  [CP] [FORMAT1]  # All
(p|hr)wfs(|1|2):dc.headTemp  [MK] [FORMAT1]   # All

#[SECTION] Wfs RMS Values
#[ITEMSPERROW] 3
#[SUBTABLE] True
pwfs1:dc:aoRms
pwfs2:dc:aoRms
oiwfs:dc:aoRms
((pwfs(1|2))|oiwfs):dc:aoRms [FORMAT1]  # All

#[SECTION] P1 + P2 astigmatism: allows to see transition from one to the other guider
pwfs1:dc:aoZ.VALD
pwfs1:dc:aoZ.VALE
pwfs2:dc:aoZ.VALD
pwfs2:dc:aoZ.VALE
pwfs(1|2):dc:aoZ.VAL(D|E)  [FORMAT1]   # All

#[SECTION] P1 + OIWFS astigmatism: allows to see transition from one to the other guider (i.e. good relative calibration)
pwfs1:dc:aoZ.VALD
pwfs1:dc:aoZ.VALE
oiwfs:dc:aoZ.VALD
oiwfs:dc:aoZ.VALE
(p|oi)wfs(|1):dc:aoZ.VAL(D|E)  [FORMAT1]   # All

#[SECTION] M1 tuning: P1 astigmatism, coma trefoil: allows to see how good the M1/M2 LUTs are
pwfs1:dc:aoZ.VALD
pwfs1:dc:aoZ.VALE
pwfs1:dc:aoZ.VALF
pwfs1:dc:aoZ.VALG
pwfs1:dc:aoZ.VALI
pwfs1:dc:aoZ.VALJ
pwfs1:dc:aoZ.VAL(D|E|F|G|I|J)   [FORMAT1]   # All

#[SECTION] P1 high order Zernikes
#[ITEMSPERROW] 2
#[SUBTABLE] False
pwfs1:dc:aoZ.VALK	#Z11
pwfs1:dc:aoZ.VALL	#Z12
pwfs1:dc:aoZ.VALM	#Z13
pwfs1:dc:aoZ.VALN	#Z14
pwfs1:dc:aoZ.VALO	#Z15
pwfs1:dc:aoZ.VALP	#Z16
pwfs1:dc:aoZ.VALQ	#Z17
pwfs1:dc:aoZ.VALR	#Z18
pwfs1:dc:aoZ.VALS	#Z19
pwfs1:dc:aoZ.VALH	#spherical Z8
pwfs1:dc:aoZ.VAL(K|L|M|N|O|P|Q|R|S|H)  [FORMAT1]   # All

#[SECTION] P2 astigmatism (in Y) vs Composite Angle (in X): allows to see residual error in models
pwfs2:dc:aoZ.VALD	#Astig0
pwfs2:dc:aoZ.VALE	#Astig45
pwfs2:dc:aoZ.VALF	#CA
pwfs2:dc:aoZ.VAL(D|E|F)   [FORMAT1]   # All

#[SECTION] P2 coma
pwfs2:dc:aoZ.VALF	#Xcoma
pwfs2:dc:aoZ.VALG	#Ycoma
pwfs2:dc:aoZ.VAL(F|G)   [FORMAT1]   # All

#[SECTION] P2 FG centroid total counts and thresholds in 4 subpupils
#[ITEMSPERROW] 6
#[SUBTABLE] True
#[CELL] Total Counts
pwfs2:dc:fgDiag1P2.VALM  # #1  
pwfs2:dc:fgDiag1P2.VALN  # #2  
pwfs2:dc:fgDiag1P2.VALO  # #3  
pwfs2:dc:fgDiag1P2.VALP  # #4  
pwfs2:dc:fgDiag1P2.VAL(M|N|O|P)   [FORMAT1]  # All
#[CELL] Thresholds
pwfs2:dc:fgDiag2P2.VALA  # #1  
pwfs2:dc:fgDiag2P2.VALB  # #2  
pwfs2:dc:fgDiag2P2.VALC  # #3  
pwfs2:dc:fgDiag2P2.VALD  # #4  
pwfs2:dc:fgDiag2P2.VAL(A|B|C|D)   [FORMAT1]  # All

#[SECTION] WFS FG Centroids Position displayed in control CB
#[ITEMSPERROW] 1
#[SUBTABLE] True
oiwfs:dc:fgDiag1P2.VALA #OIWFS (to TCS)
f2oi:dc:fgDiag1P2.VALA #F2OI
gmoi:dc:fgDiag1P2.VALA #GMOS
pwfs1:dc:fgDiag1P2.VALA #P1
pwfs2:dc:fgDiag1P2.VALA #P2

#[SECTION] P2 aO centroid total counts in 4 subpupils
#[ITEMSPERROW] 4
#[SUBTABLE] True
pwfs2:dc:aoDiagP2.VALK      # #1  
pwfs2:dc:aoDiagP2.VALL      # #2  
pwfs2:dc:aoDiagP2.VALM      # #3  
pwfs2:dc:aoDiagP2.VALN      # #4  
pwfs2:dc:aoDiagP2.VAL(K|L|M|N)  [FORMAT1]   # All

#[SECTION] P2 aO centroid threshold in 4 subpupils
#[ITEMSPERROW] 4
#[SUBTABLE] True
pwfs2:dc:aoDiagP2.VALQ      # #1 
pwfs2:dc:aoDiagP2.VALR      # #2 
pwfs2:dc:aoDiagP2.VALS      # #3 
pwfs2:dc:aoDiagP2.VALT      # #4 
pwfs2:dc:aoDiagP2.VAL(Q|R|S|T)   [FORMAT1]   # All

#[SECTION] P2 aO centroid X position in 4 subpupils
#[ITEMSPERROW] 4
#[SUBTABLE] True
pwfs2:dc:aoDiagP2.VALC      # #1 
pwfs2:dc:aoDiagP2.VALE      # #2 
pwfs2:dc:aoDiagP2.VALG      # #3 
pwfs2:dc:aoDiagP2.VALI      # #4 
pwfs2:dc:aoDiagP2.VAL(C|E|G|I)   [FORMAT1]   # All

#[SECTION] P2 aO centroid Y position in 4 subpupils
#[ITEMSPERROW] 4
#[SUBTABLE] True
pwfs2:dc:aoDiagP2.VALD      # #1 
pwfs2:dc:aoDiagP2.VALF      # #2 
pwfs2:dc:aoDiagP2.VALH      # #3 
pwfs2:dc:aoDiagP2.VALJ      # #4 
pwfs2:dc:aoDiagP2.VAL(D|F|H|J)   [FORMAT1]   # All

#[SECTION] P2 0 point astigmatism model
pwfs2:dc:aoZero.VALG    # ast0
pwfs2:dc:aoZero.VALH    # ast45
pwfs2:dc:aoZero.VAL(G|H)   [FORMAT1]   # All

#[SECTION] P2 composite angle
pwfs2:dc:ttfZero.VALF

#[SECTION] P1 aO centroid counts in 4 subpupils
#[ITEMSPERROW] 5
#[SUBTABLE] True
pwfs1:dc:aoDiag4P1.VALN         # #3  
pwfs1:dc:aoDiag4P1.VALO         # #4  
pwfs1:dc:aoDiag4P1.VALS         # #8  
pwfs1:dc:aoDiag4P1.VALT         # #9 
pwfs1:dc:aoDiag4P1.VALU         # #10
pwfs1:dc:aoDiag5P1.VALA         # #11 
pwfs1:dc:aoDiag5P1.VALC         # #13  
pwfs1:dc:aoDiag5P1.VALD         # #14  
pwfs1:dc:aoDiag5P1.VALG         # #17  
pwfs1:dc:aoDiag5P1.VALH         # #18 
pwfs1:dc:aoDiag5P1.VALI         # #19  
pwfs1:dc:aoDiag5P1.VALJ         # #20  
pwfs1:dc:aoDiag5P1.VALM         # #23  
pwfs1:dc:aoDiag5P1.VALN         # #24  
pwfs1:dc:aoDiag5P1.VALP         # #26  
pwfs1:dc:aoDiag5P1.VALQ         # #27  
pwfs1:dc:aoDiag5P1.VALR         # #28  
pwfs1:dc:aoDiag5P1.VALS         # #29  
pwfs1:dc:aoDiag6P1.VALB         # #33  
pwfs1:dc:aoDiag6P1.VALC         # #34 
pwfs1:dc:aoDiag(4|5|6)P1.VAL(N|O|S|T|U|A|C|D|G|H|I|J|M|N|P|Q|T|R|B|C)   [FORMAT1]   # All

#[SECTION] P1 aO centroid threshold in 4 subpupils
#[ITEMSPERROW] 5
#[SUBTABLE] True
pwfs1:dc:aoDiag6P1.VALJ         # #3  
pwfs1:dc:aoDiag6P1.VALK         # #4  
pwfs1:dc:aoDiag6P1.VALO         # #8  
pwfs1:dc:aoDiag6P1.VALP         # #9  
pwfs1:dc:aoDiag6P1.VALQ         # #10 
pwfs1:dc:aoDiag6P1.VALR         # #11 
pwfs1:dc:aoDiag6P1.VALT         # #13 
pwfs1:dc:aoDiag6P1.VALU         # #14 
pwfs1:dc:aoDiag7P1.VALC         # #17 
pwfs1:dc:aoDiag7P1.VALD         # #18 
pwfs1:dc:aoDiag7P1.VALE         # #19 
pwfs1:dc:aoDiag7P1.VALF         # #20 
pwfs1:dc:aoDiag7P1.VALI         # #23 
pwfs1:dc:aoDiag7P1.VALJ         # #24 
pwfs1:dc:aoDiag7P1.VALL         # #26 
pwfs1:dc:aoDiag7P1.VALM         # #27 
pwfs1:dc:aoDiag7P1.VALN         # #28 
pwfs1:dc:aoDiag7P1.VALO         # #29 
pwfs1:dc:aoDiag7P1.VALS         # #33 
pwfs1:dc:aoDiag7P1.VALT         # #34 
pwfs1:dc:aoDiag(6|7)P1.VAL(J|K|O|P|Q|R|T|U|C|D|E|F|I|J|L|M|N|O|S|T)  [FORMAT1]   # All

#[SECTION] P1 0 point astigmatism model
pwfs1:dc:aoZero.VALG    	# P1 0point model ast0
pwfs1:dc:aoZero.VALH    	# P1 0point model ast45
pwfs1:dc:aoZero.VAL(G|H)   [FORMAT1]   # All
#[SECTION] P1 composite angle
pwfs1:dc:ttfZero.VALF

oiwfs:dc:fgDiag1P2.VALM
oiwfs:dc:fgDiag1P2.VALN
oiwfs:dc:fgDiag1P2.VALO
oiwfs:dc:fgDiag1P2.VALP
oiwfs:dc:fgDiag1P2.VAL(M|N|O|P)   [FORMAT1]   # All


#[SECTION] TTF
#[ITEMSPERROW] 3
#[SUBTABLE] True
pwfs1:dc:ttf.VALA    # Xtilt of P1 (sent to M2)
pwfs1:dc:ttf.VALB    # Ytilt of P1 (sent to M2)
pwfs1:dc:ttf.VALC    # focus of P1 (sent to M2)
pwfs2:dc:ttf.VALA    # Xtilt of P2 (sent to M2)
pwfs2:dc:ttf.VALB    # Ytilt of P2 (sent to M2)
pwfs2:dc:ttf.VALC    # focus of P2 (sent to M2) 

#[SECTION] OIWFS total counts per quadrant
#[ITEMSPERROW] 2
#[SUBTABLE] True
oiwfs:dc:fgDiag1P2.VALM
oiwfs:dc:fgDiag1P2.VALN
oiwfs:dc:fgDiag1P2.VALO
oiwfs:dc:fgDiag1P2.VALP
oiwfs:dc:fgDiag1P2.VAL(M|N|O|P)   [FORMAT1]   # All

#[SECTION] GMOS OIWFS total counts per quadrant
#[ITEMSPERROW] 2
#[SUBTABLE] True
gmoi:dc:fgDiag1P2.VALM
gmoi:dc:fgDiag1P2.VALN
gmoi:dc:fgDiag1P2.VALO
gmoi:dc:fgDiag1P2.VALP
gmoi:dc:fgDiag1P2.VAL(M|N|O|P)   [FORMAT1]   # All

#[SECTION] F2 OIWFS total counts per quadrant
#[ITEMSPERROW] 2
#[SUBTABLE] True
f2oi:dc:fgDiag1P2.VALM
f2oi:dc:fgDiag1P2.VALN
f2oi:dc:fgDiag1P2.VALO
f2oi:dc:fgDiag1P2.VALP
f2oi:dc:fgDiag1P2.VAL(M|N|O|P)   [FORMAT1]   # All

#[SECTION] OIWFS Thresholds
#[ITEMSPERROW] 2
#[SUBTABLE] True
oiwfs:dc:fgDiag2P2.VALA
oiwfs:dc:fgDiag2P2.VALB
oiwfs:dc:fgDiag2P2.VALC
oiwfs:dc:fgDiag2P2.VALD
oiwfs:dc:fgDiag2P2.VAL(A|B|C|D)   [FORMAT1]   # All

#[SECTION] OIWFS other
#[ITEMSPERROW] 1
#[SUBTABLE] True
oiwfs:dc:ttf.VALA    
oiwfs:dc:ttf.VALB 	 
oiwfs:dc:ttf.VALC 	 
oiwfs:dc:fgDiag1P2.VALB

#[SECTION] Sky Dark fits file
#[ITEMSPERROW] 2
#[SUBTABLE] True
#[QUERYSTRPAIRS] {'FORMAT':'Spreadsheet'}
pwfs1:dc:aoDarkInit
pwfs2:dc:aoDarkInit
gmoi:dc:aoDarkInit
f2oi:dc:aoDarkInit
(pwfs1|pwfs2|gmoi|f2oi):dc:aoDarkInit   [FORMAT1]   # All

