        {
          "id": "s",
          "name": "",
          "expanded": true
        }
      ]
    },
    "sync": true,
    "initial": {
      "method": "-",
      "code": "\nconst tpl = context.grafana.templateService;\nconst from = new Date(Number(tpl.replace('${__from}')));\nconst to = new Date(Number(tpl.replace('${__to}')));\nconst parts = (d) => ({\n  date: new Date(d.getFullYear(), d.getMonth(), d.getDate()).toISOString(),\n  h: d.getHours(), m: d.getMinutes(), s: d.getSeconds(),\n});\nconst f = parts(from), t = parts(to);\ncontext.panel.patchFormValue({\n  startDate: f.date, startH: f.h, startM: f.m, startS: f.s,\n  endDate: t.date, endH: t.h, endM: t.m, endS: t.s,\n});\ncontext.panel.enableSubmit();\n",
      "highlight": false
    },
    "updateEnabled": "manual",
    "update": {
      "method": "-",
      "code": "\nconst v = context.panel.formValue;\nconst ms = (side) => {\n  const d = new Date(v[side + 'Date']);\n  return new Date(d.getFullYear(), d.getMonth(), d.getDate(),\n                  Number(v[side + 'H']), Number(v[side + 'M']), Number(v[side + 'S'])).getTime();\n};\nconst from = ms('start'), to = ms('end');\nif (!(to > from)) {\n  context.grafana.notifyError(['Time range', 'End must be after start.']);\n  return;\n}\ncontext.grafana.locationService.partial({ from: String(from), to: String(to) }, true);\n",
      "confirm": false
    },
    "buttonGroup": {
      "orientation": "right",
      "size": "md"
    },
    "submit": {
      "variant": "primary",
      "icon": "clock-nine",
      "text": "Apply time range"
    },
    "reset": {
      "variant": "hidden"
    },
    "saveDefault": {
      "variant": "hidden"
    },
