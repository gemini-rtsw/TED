        "afterRender": "",
        "content": "<table class=\"dataTable\">\n  <tr>\n    <th>Timestamp</th>\n    <th>Subsystem</th>\n    <th>Message</th>\n  </tr>\n  {{#each data}}\n  <tr>\n    <td class=\"ts\">{{changeTime timestamp}}</td>\n    <td class=\"ss\">{{subsystem}}</td>\n    <td class=\"msg\">{{msg}}</td>\n  </tr>\n  {{/each}}\n</table>\n",
        "contentPartials": [],
        "defaultContent": "<table class=\"dataTable\">\n  <tr>\n    <th>Timestamp</th>\n    <th>Subsystem</th>\n    <th>Message</th>\n  </tr>\n</table>",
        "editor": {
          "format": "auto",
          "height": 283,
          "language": "handlebars"
        },
        "editors": [
          "helpers",
          "styles"
        ],
        "externalScripts": [],
        "externalStyles": [],
        "helpers": "const formatOptions = {\n  year: 'numeric',\n  month: 'numeric',\n  day: 'numeric',\n  hour: '2-digit',\n  minute: '2-digit',\n  second: '2-digit',\n  fractionalSecondDigits: 3,\n  hourCycle: 'h23',\n  timeZone: context.panelData.request.timezone != 'browser' ? context.panelData.request.timezone : Intl.DateTimeFormat().resolvedOptions().timeZone\n};\n\ncontext.handlebars.registerHelper('changeTime', function (timestamp) {\n  const date = new Date(timestamp);\n  const formattedTime = date.toLocaleString('en-US', formatOptions);\n  const [datePart, timePart] = formattedTime.split(', ');\n  const [month, day, year] = datePart.split('/');\n  const [hours, minutes, seconds] = timePart.split(':');\n  const [second, fraction] = seconds.split('.');\n  return `${day}/${month}/${year} ${hours}:${minutes}:${second}.${fraction}`;\n});\n\n\n\nlet lucene = \"\";\nconst rawQuery = context.grafana.replaceVariables(\"$search_message\").trim();\n\nif (rawQuery === \"\") {\n  lucene = \"msg:**\";\n} else {\n  const query = rawQuery.split(/\\s+/);\n  for (let word of query) {\n    if (\n      word === \"AND\" ||\n      word === \"OR\" ||\n      word === \"NOT\" ||\n      word === \"(\" ||\n      word === \")\"\n    ) {\n      lucene += word + \" \";\n    } else {\n      lucene += `msg:*${word}* `;\n    }\n  }\n  lucene = lucene.trim();\n}\n\ncontext.grafana.locationService.partial({ \"var-lucene_query\": lucene }, true);\n\ndocument.addEventListener('keydown', (e) => {\n  if (e.key == \"Enter\") {\n    context.grafana.refresh();\n  }\n})\n\n",
        "renderMode": "allRows",
        "styles": ".dataTable {\n  width: 100%;\n}\n\n.ts {\n  min-width: 11vw;\n}\n\n.ss {\n  min-width: 5vw;\n}\n\n.msg {\n  min-width: 80vw;\n}\n\nth {\n  top: -1px;\n  margin: 0%;\n  position: -webkit-sticky;\n  position: sticky;\n  z-index: 2;\n}",
        "wrap": true
