      "options": {
        "afterRender": "const container = document.getElementById('pvTree');\ncontainer.innerHTML = \"\"\n\nconst jsonString = context.data[0][0].pvTree;\nconst data = JSON.parse(jsonString);\n\n\nfunction buildTree(obj, container, path=[]) {\n  for (const key in obj) {\n    const currentPath = [...path, key];\n    if ('codes' in obj[key]) {\n      const wrapper = document.createElement('div');\n      wrapper.className = 'tree'\n      const keyDiv = document.createElement('div');\n      keyDiv.className = 'leaf';\n      keyDiv.textContent = key;\n      const codes = JSON.stringify(obj[key][\"codes\"]);\n      keyDiv.dataset.codes = codes;\n      keyDiv.dataset.path = currentPath.join(\" > \");\n      keyDiv.addEventListener(\"click\", () => {\n        arrCodes = JSON.parse(keyDiv.dataset.codes);\n        context.grafana.locationService.partial(\n          {\n            'var-pv': arrCodes,\n          },\n          true\n        )\n        context.grafana.locationService.partial(\n          {\n            'var-title': keyDiv.dataset.path,\n          },\n          true\n        )\n      })\n      wrapper.appendChild(keyDiv);\n      container.appendChild(wrapper);\n    }\n    else {\n      const value = obj[key];\n      const wrapper = document.createElement('div');\n      wrapper.className = 'tree'\n      const keyDiv = document.createElement('div');\n      keyDiv.className = 'key';\n      keyDiv.textContent = key;\n      const childrenContainer = document.createElement('div');\n      childrenContainer.className = 'children hidden';\n      if (typeof value === 'object' && value !== null) {\n        buildTree(value, childrenContainer, currentPath);\n        keyDiv.addEventListener(\"click\", () => {\n          childrenContainer.classList.toggle('hidden');\n        })\n      }\n      wrapper.appendChild(keyDiv);\n      wrapper.appendChild(childrenContainer);\n      container.appendChild(wrapper);\n    }\n  }\n}\nbuildTree(data, container);\n\n\n",
        "content": "<div id=\"pvTree\"></div>",
        "contentPartials": [],
