      "id": 1,
      "options": {
        "afterRender": "const container = document.getElementById('pvTree');\nif (container) container.innerHTML = \"\";\n\nconst jsonString = context.data[0][0].pvTree;\nconst data = JSON.parse(jsonString);\n\nconst collBtn = document.getElementById('collBtn');\ncollBtn.addEventListener(\"click\", () => {\n  document.querySelectorAll('.children').forEach(el => {\n    el.classList.add('hidden');\n  });\n  document.querySelectorAll('.expand-icon').forEach(icon => {\n    icon.textContent = '▶';\n  });\n  Object.keys(localStorage)\n    .filter(k => k.startsWith(\"treeExpanded:\"))\n    .forEach(k => localStorage.setItem(k, \"false\"));\n});\n\n\nfunction buildTree(obj, container, path = []) {\n  for (const key in obj) {\n    const currentPath = [...path, key];\n\n    if ('codes' in obj[key]) {\n      const wrapper = document.createElement('div');\n      wrapper.className = 'tree';\n\n      const keyDiv = document.createElement('div');\n      keyDiv.className = 'leaf';\n\n      const nameText = document.createElement('div');\n      nameText.textContent = key;\n      nameText.className = 'nameText';\n      keyDiv.appendChild(nameText);\n\n      const appendBtn = document.createElement('button');\n      appendBtn.className = 'appendBtn';\n      appendBtn.textContent = '+';\n      appendBtn.addEventListener(\"click\", (e) => {\n        e.stopPropagation();\n        const arrCodes = JSON.parse(appendBtn.parentElement.dataset.codes);\n        let selectedPVs = context.grafana.replaceVariables(\"${pv:csv}\").split(\",\");\n        for (const code of arrCodes) {\n          if (!selectedPVs.includes(code)) {\n            selectedPVs.push(code);\n          }\n        }\n        context.grafana.locationService.partial({\n          'var-pv': selectedPVs\n        }, true);\n      });\n\n      keyDiv.appendChild(appendBtn);\n\n      keyDiv.dataset.codes = JSON.stringify(obj[key][\"codes\"]);\n      keyDiv.dataset.path = currentPath.join(\" > \");\n\n      keyDiv.addEventListener(\"click\", () => {\n        const arrCodes = JSON.parse(keyDiv.dataset.codes);\n        context.grafana.locationService.partial({\n          'var-pv': arrCodes,\n          'var-title': keyDiv.dataset.path\n        }, true);\n      });\n\n      wrapper.appendChild(keyDiv);\n      container.appendChild(wrapper);\n    } else {\n      const value = obj[key];\n      const wrapper = document.createElement('div');\n      wrapper.className = 'tree';\n\n      const keyDiv = document.createElement('div');\n      keyDiv.className = 'key';\n\n      const expandIcon = document.createElement('span');\n      const nodePath = currentPath.join(\" > \");\n      const isExpanded = localStorage.getItem(`treeExpanded:${nodePath}`) === \"true\";\n      expandIcon.textContent = isExpanded ? '▼' : '▶';\n      expandIcon.className = 'expand-icon';\n      keyDiv.appendChild(expandIcon);\n\n      const keyText = document.createElement('span');\n      keyText.textContent = ` ${key}`;\n      keyDiv.appendChild(keyText);\n\n      const childrenContainer = document.createElement('div');\n      childrenContainer.className = 'children';\n      if (!isExpanded) {\n        childrenContainer.classList.add('hidden');\n      }\n\n      if (typeof value === 'object' && value !== null) {\n        buildTree(value, childrenContainer, currentPath);\n\n        keyDiv.addEventListener(\"click\", () => {\n          const isHidden = childrenContainer.classList.toggle('hidden');\n          expandIcon.textContent = !isHidden ? '▼' : '▶';\n          localStorage.setItem(`treeExpanded:${nodePath}`, (!isHidden).toString());\n        });\n      }\n\n      wrapper.appendChild(keyDiv);\n      wrapper.appendChild(childrenContainer);\n      container.appendChild(wrapper);\n    }\n  }\n}\n\nbuildTree(data, container);\n\n",
        "content": "<div id=\"collBtn\">Collapse</div>\n<div id=\"pvTree\"></div>",
        "contentPartials": [],
        "defaultContent": "The query didn't return any results.",
        "editor": {
          "format": "auto",
          "language": "html"
        },
        "editors": [
          "afterRender",
          "styles"
        ],
        "externalStyles": [],
        "helpers": "",
        "renderMode": "data",
        "styles": "#collBtn{\n  width: fit-content;\n  background-color: rgb(17, 18, 23);\n  color: white;\n  padding: 5px;\n  text-align: center;\n  cursor: pointer;\n}\n#collBtn:hover{\n  background-color: rgb(207, 138, 8);\n}\n\n.tree {\n  width: 100%;\n  font-family: monospace;\n  background-color: ${theme.colors.background.primary};\n}\n\n.key {\n  font-weight: 600;\n  color: #FAFAFA;\n  padding: 4px 6px;\n  cursor: pointer;\n  border-radius: 4px;\n  transition: background-color 0.2s ease;\n}\n\n.expand-icon {\n  display: inline-block;\n  width: 14px;\n  text-align: center;\n}\n\n.leaf {\n  background-color: rgb(24, 27, 31);\n  border-radius: 2px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 0px 20px 0px 20px;\n}\n\n.leaf:hover {\n  background-color: rgb(207, 138, 8);\n  cursor: pointer;\n}\n\n.leaf:hover .nameText {\n  color: #FAFAFA;\n}\n.leaf:hover .appendBtn {\n   display: inline-flex;\n}\n\n.nameText {\n  color: rgb(207, 138, 8);\n  font-weight: bold;\n  cursor: pointer;\n  padding: 1px;\n  transition: background-color 0.2s ease;\n}\n\n.appendBtn {\n  display: none;\n  width: 16px;\n  height: 16px;\n  border: none;\n  border-radius: 2px;\n  background-color: #FAFAFA;\n  color: #a77d0b;\n  font-size: 20px;\n  font-weight: bold;\n  align-items: center;\n  justify-content: center;\n  cursor: pointer;\n  transition: background-color 0.2s ease;\n}\n\n.appendBtn:hover {\n  background-color:  rgb(17, 18, 23);\n}\n\n.children {\n  margin-left: 20px;\n  border-left: 1px dashed #ccc;\n  padding-left: 10px;\n}\n\n.hidden {\n  display: none;\n}\n",
