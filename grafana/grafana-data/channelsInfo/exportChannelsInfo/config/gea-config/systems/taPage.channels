#TimeAudit page layout

#Defaults options for all selections for all sections:
#[ITEMSPERROW] 4
#[QUERYSTRPAIRS] {'SYSTEMS':'timeAudit','LEGEND':'Inside', 'GRIDLINES':'checked','FORMAT':'Plot'}
#This below is used to control whether each section should have its own html table. 
#[SUBTABLE] False

#[SECTION]  Information about the time synchronization (current reference AG clock)
#[CSSCLASS] sectionMain
#[ITEMSPERROW] 4
#[SUBTABLE] True
#[QUERYSTRPAIRS] {'SYSTEMS':'ta', 'DPI':'125'}
ta:(cr|m2|mc|tcs|ag|ta):diff # Delay to time reference
ta:(ta|cr|m2|mc|tcs|ag):timeDemux.VALG # Difference since last 1Hz update
(ta|cr|m2|mc|tcs|ag):timeProbe:TAI.VALA # Full time info array

#[QUERYSTRPAIRS] {'YMAX':'0.001', 'YLABEL':'Seconds', 'PLOTTITLE':'Running RMS Error of the last 10 samples'  }
ta:(cr|m2|mc|tcs|ag|ta):rmsErr.VALJ # Rms Error
# Some cleaner plots
ta:(cr|mc|tcs):rmsErr.VALJ # RmsErr-tcs-mcs-crcs
ta:(ta|tcs):rmsErr.VALJ # RmsErr-tcs-ta
#[QUERYSTRPAIRS] {'YMAX':'0.002', 'YMIN':'0', 'YLABEL':'Seconds', 'PLOTTITLE':'Difference to timeAudit clock'  }
ta:(cr|mc|tcs):diff # Delay-tcs-mcs-crcs
ta:(tcs|ta):diff # Delay-tcs-ta

#[SECTION] Last 30 minutes
#[QUERYSTRPAIRS] {'SYSTEMS':'ta', 'DPI':'125'}
#[QUERYSTRPAIRS] {'LAPSE':30,'FORMAT':'Plot'}
#[QUERYSTRPAIRS] {'YMAX':'0.005', 'YMIN':'-0.005', 'YLABEL':'Seconds'}
ta:(tcs|ta):diff # Delay from reference to TCS and timeAudit(TA)
ta:(cr|mc|m2):diff # Delay from reference to CRCS, MCS and SCS
