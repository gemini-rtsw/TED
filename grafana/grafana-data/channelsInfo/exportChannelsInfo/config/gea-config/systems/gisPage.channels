#GIS page layout

#Defaults options for all selections for all sections:
#[ITEMSPERROW] 3
#[QUERYSTRPAIRS] {'SYSTEMS':'gis','LEGEND':'Inside', 'GRIDLINES':'checked'}
#This below is used to control whether each section should have its own html table. 
#[SUBTABLE] False

#[SECTION] PAZ Bearings Pressure (bars)
#[ITEMSPERROW] 3
#[SUBTABLE] True
#[CELL] G1 (+X-Y)
gis:mon:azmon2:vrbpG1c.VAL  # Vertical
gis:mon:azmon2:rabpG1c.VAL	# Radial
#[CELL] G2 (-X-Y)
gis:mon:azmon2:vrbpG2c.VAL	# Vertical
gis:mon:azmon2:rabpG2c.VAL	# Radial
#[CELL] G3 (+X+Y)
gis:mon:azmon2:vrbpG3c.VAL	# Vertical
gis:mon:azmon2:rabpG3c.VAL	# Radial
#[CELL] G4 (-X+Y)
gis:mon:azmon2:vrbpG4c.VAL	# Vertical
gis:mon:azmon2:rabpG4c.VAL	# Radial
#[CELL] G5 (+X)
gis:mon:azmon2:vrbpG5c.VAL	# Vertical
gis:mon:azmon2:rabpG5c.VAL	# Radial
#[CELL] G6 (-X)
gis:mon:azmon2:vrbpG6c.VAL	# Vertical
gis:mon:azmon2:rabpG6c.VAL	# Radial

#[SECTION] ALT Bearings Pressure (bars)
#[ITEMSPERROW] 4
#[SUBTABLE] True
#[CELL] H1 (-X)
gis:mon:altmon2:bpH1861c.VAL	   # Axial(861)
gis:mon:altmon2:bpH1862c.VAL	   # Radial(862)
gis:mon:altmon2:bpH1863c.VAL	   # Radial(863)
#[CELL] H2 (+X)
gis:mon:altmon2:bpH2861c.VAL	 # Axial(861)
gis:mon:altmon2:bpH2862c.VAL	 # Radial(862)
gis:mon:altmon2:bpH2863c.VAL	 # Radial(863)

#[SECTION] Position encoder 
#[ITEMSPERROW] 3
#[SUBTABLE] True
gis:mon:azmon3:azposenc.VAL  # Azimuth (from GIS)
#[QUERYSTRPAIRS] {'SYSTEMS':'mcs'}
mc:elCurrentPos      # Elevation (from MCS)
mc:azCurrentPos      # Azimuth (from MCS)

#[SECTION] Azimuth Kaman sensors
#[ITEMSPERROW] 3
#[SUBTABLE] True
gis:mon:azkam:g1(k|z).*       #   G1
gis:mon:azkam:g2(k|z).*       #   G2
gis:mon:azkam:g3(k|z).*       #   G3
gis:mon:azkam:g4(k|z).*       #   G4
gis:mon:azkam:g5(k|z).*       #   G5
gis:mon:azkam:g6(k|z).*       #   G6

#[SECTION] Alt Bearings
#[ITEMSPERROW] 2
#[SUBTABLE] True
gis:mon:altkam:h1a.*	    # H1A
gis:mon:altkam:h2a.*	    # H2A
gis:mon:altkam:h1b.*	    # H1B
gis:mon:altkam:h2b.*	    # H2B

#[SECTION] Thermal Enclosure Temperatures
#[ITEMSPERROW] 4
#[SUBTABLE] True
gis:mon:temp:pcs.VAL   # PCS  
gis:mon:temp:crcs.VAL  # CRCS
gis:mon:temp:scs.VAL   # SCS
gis:mon:temp:cem.VAL   # CEM

#[SECTION] PMAC output voltage (ALT, Az)
#[ITEMSPERROW] 2
#[SUBTABLE] True
gis:mon:altmon3:altdspdspc.VAL          # ALT
gis:mon:azmon3:azdspdspc.VAL            # Az

#[SECTION] Automount Step Numbers (Spreadsheet)
#[ITEMSPERROW] 2
#[SUBTABLE] True
#[QUERYSTRPAIRS] {'FORMAT':'Spreadsheet'}
gis:az:azmd:azmdautoss.VAL                  # Azimuth auto mode
gis:alt:altmd:altmdautoss.VAL               # Elevation auto mode

#[SECTION] M1 Screw Count 
#[ITEMSPERROW] 3
#[SUBTABLE] True
gis:mon:other:m1posxscrewi.VAL          #  +X 
gis:mon:other:m1negxscrewi.VAL          #  -X 
gis:mon:other:m1(pos|neg)xscrewi.VAL    #  +X and -X 

#[SECTION] Faults (Spreadsheet)
#[ITEMSPERROW] 1
#[SUBTABLE] True
#[QUERYSTRPAIRS] {'FORMAT':'Spreadsheet'}
gis:mon:other:m1covskewedi.VAL # M1 cover skewed
gis:mon:other:m1instsums.VAL   # Instrument Cover (The Iris)
gis:az:azos:azosi.VAL   #AZ overspeed fault
gis:alt:altos:altosi.VAL    #ALT overspeed fault
gis:az:azo(s|t):azo(si|t0(1|2|3|4)i).VAL  # AZ Overtravel Faults
gis:alt:altot:altot(sums|zen0(1|2)i|hor0(1|2)i).VAL   # ALT Overtravel Faults
gis:az:azns:aznssums.VAL  # AZ non-zero speed fault
gis:alt:altns:altnssums.VAL  # ALT non-zero speed fault
gis:alt:altcw:altcw(hi|lo)posxi.VAL #ALT cable Wrap Faults (+X)
gis:alt:altcw:altcw(hi|lo)negxi.VAL #ALT cable Wrap Faults (-X)
gis:alt:altcw:altcw(hi|lo)(pos|neg)xi.VAL|gis:alt:altcw:altcwsums.VAL  #ALT cable Wrap Faults (+X, -X and Sum)
gis:(az:aztb:aztbi.VAL|gis:az:azot:azotsums.VAL|az:azcw:azcwsums.VAL|az:azombr:azombrsums.VAL|az:azpp:azppi.VAL|misc:misczsums.VAL|az:azos:azosi.VAL|az:azdr:azdrsums.VAL|ck:cksums.VAL|hbs:hbssums.VAL|az:azns:aznssums.VAL|az:azbr:azbri.VAL|az:azlo:azlosums.VAL|alt:altlp:altlpsum1s.VAL|az:azbg:azbgsums.VAL) # AZ Faults
gis:(pcs:pcssums.VAL|alt:altot:altotsums.VAL|alt:altcw:altcwsums.VAL|alt:altombr:altombrsums.VAL|alt:altpp:altppi.VAL|misc:misclsums.VAL|alt:altos:altosi.VAL|alt:altdr:altdrsums.VAL|ck:cksums.VAL|hbs:hbssums.VAL|alt:altns:altnssums.VAL|alt:altbr:altbrsums.VAL|alt:altlo:altlosums.VAL|alt:altlp:altlpsums.VAL|alt:altbg:altbgsums.VAL|cass:gmdoor.VAL|cass:gmintf.VAL) # ATL Faults
gis:(cass:rwpmaci.VAL|cass:rdri.VAL|cass:rdrdci.VAL|cass:rcwi.VAL|cass:rccwi.VAL|cass:wdri.VAL|cass:wdrdci.VAL|cass:wcwi.VAL|cass:wccwi.VAL|cass:gmdoor.VAL|cass:gmintf.VAL)    # Cassegrian Faults 
gis:pcs:no(reli|disablei|grabi).VAL                                     # PCS Faults 
gis:rack:r(00|01|02|03|04|05|06|07|10)i.VAL                             #PCL Rack Faults
gis:es:(es01i|e01i|e03i|e02i|e04i|e23i|e24i|e10i|e11i|e12i|e13i|e14i|e01i|e02i|e03i|e04i|e05i|e06i|e20i|e21i|e22i|e23i|e24i|e25i|e26i|e28i|e29i|plxm|plctripi).VAL    # Emergency Stop and PLX Faults
gis:int:int(01|02|03|04|05|06|07|08|09|10|11|12|13|14|15|16)i.VAL       # Interfaces

#[SECTION] Misc
#[ITEMSPERROW] 1
