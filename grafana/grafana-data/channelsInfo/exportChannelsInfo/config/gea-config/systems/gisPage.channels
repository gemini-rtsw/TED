#[QUERYSTRPAIRS] {'FORMAT':'Plot'}
gis:mon:azmon3:azdspdspc.VAL  # AZ Speed Set Pt. (volts) 
gis:mon:altmon3:altdspdspc.VAL #  ALT Speed Set Pt. (volts)
