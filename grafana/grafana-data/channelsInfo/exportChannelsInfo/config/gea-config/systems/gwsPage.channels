#GWS page layout

#Defaults options for all selections for all sections:
#[ITEMSPERROW] 2
#[QUERYSTRPAIRS] {'SYSTEMS':'gws','LEGEND':'Inside', 'GRIDLINES':'checked'}
#This below is used to control whether each section should have its own html table. 
#[SUBTABLE] False

#[SECTION] [MK] Weather Data  Ultrasonic anemometers (-X) 
ws:tpUaMxSpeed2D    # Two dimensional wind speed
ws:tpUaMxSpeed3D    # Three dimensional wind speed
ws:tpUaMxWindAz     # Wind direction (azimuth)
ws:tpUaMxWindEl     # Wind elevation
ws:tpUaMxTemp       # Sonic temperature

#[SECTION] [MK] Weather Data  Ultrasonic anemometers (+X) 
ws:tpUaPxSpeed2D    # Two dimensional wind speed
ws:tpUaPxSpeed3D    # Three dimensional wind speed
ws:tpUaPxWindAz     # Wind direction (azimuth)
ws:tpUaPxWindEl     # Wind elevation
ws:tpUaPxTemp       # Sonic temperature

#[SECTION] [MK] Weather Data  Ultrasonic anemometers (Top end)
ws:tpUaTeSpeed2D    # Two dimensional wind speed
ws:tpUaTeSpeed3D    # Three dimensional wind speed
ws:tpUaTeWindAz     # Wind direction (azimuth)
ws:tpUaTeWindEl     # Wind elevation
ws:tpUaTeTemp       # Sonic temperature

#[SECTION] [MK] Particle monitor
ws:tpPmPxChan1    # Counts channel #1 (0.3 microns)
ws:tpPmPxChan2    # Counts channel #2 (user defined)
ws:metTime        # Sampling time
ws:metSize        # Particle size for channel #2

#[SECTION] [MK] Humidity Sensor
ws:tpHsPxTw    #  Wet bulb temperature
ws:tpHsPxRh      #Relative humidty
ws:tpHsPxT       #Temperature
ws:tpHsPxTd      #Dew temperature
ws:tpHsPxA       #Absolute humidity
ws:tpHsPxX       #Mixing ratio
ws:tpHsPxDt      #Dew point difference

#[SECTION] [MK] Weather Data  
ws:cfTemp       # Temperature
ws:cfPress      # Pressure
ws:cfWindSpeed  # Wind Speed 
ws:cfWindDir    # Wind Direction
ws:cfHumid      # Humidity
ws:wsDew        # Dew Point

#[SECTION] [MK]  Pier Lab
ws:pltAbPl              # Air sensor 2 meters above floor  
ws:pltAbAwPl            # Air sensor 2 meters above and 3 meters away
ws:pltFlPl              # Surface sensor floor
ws:pltAbOuPl            # Air sensor outside pier lab
ws:plyng0Pressure       # Barometric pressure sensor   

#[SECTION] [CP]  Weather Data  
ws:..Temp       # Temperature
ws:..Press      # Pressure
ws:..WindSpeed  # Wind Speed 
ws:..WindDir    # Wind Direction
ws:..Humid      # Humidity
ws:..Dew        # Dew Point
ws:pwv          # Precipitable water vapor

#[SECTION] [CP] Telescope temperature sensors
#[CELL] Top End
#[CELL]
ws:tpAtTeMx     #  Air temp.  -X   (ws:tpAtTeMx)
ws:tpStTeMx     #  Surface temp. -X (ws:tpStTeMx)
ws:tpAtTePx     #  Air tempe. +X (ws:tpAtTePx)
ws:tpStTePx     #  Surface temperature  +X (ws:tpStTePx)

#[CELL] Truss
#[CELL]
ws:tpAtMtMx     # Air temp.  -X (ws:tpAtMtMx)
ws:tpStMtMx     # Surface temp.  -X (ws:tpStMtMx)
ws:tpAtMtPx     # Air temp.  +X  (ws:tpAtMtPx)
ws:tpStMtPx     # Surface temp. +X  (ws:tpStMtPx)
#[CELL] Lower Truss
#[CELL]
ws:tpAtLtMx     # Air temp. -X  (ws:tpAtLtMx)
ws:tpStLtMx     # Surface temp. -X (ws:tpStLtMx)
ws:tpAtLtPx     # Air temp. -X (ws:tpAtLtPx)
ws:tpStLtPx     # Surface temp. -X (ws:tpStLtPx)
#[CELL] M1
#[CELL]
ws:tpStSfUp     # M1 Temperature +Y
ws:tpStSfDn     # M1 Temperature -Y

#[SECTION] [CP] Telescope Wind sensors
#[CELL] Top End
#[CELL]
ws:tpUaMxSpeed3D #  Wind Speed.  -X   (ws:tpUaMxSpeed3D)
ws:tpUaMxWindAz  #  Wind Direction. -X (ws:tpUaMxWindAz)
ws:tpUaPxSpeed3D #  Wind Speed.  +X   (ws:tpUaPxSpeed3D)
ws:tpUaPxWindAz  #  Wind Direction. +X (ws:tpUaPxWindAz)
ws:tpUaTeSpeed3D #  Wind Speed.  Top End   (ws:tpUaTeSpeed3D)
ws:tpUaTeWindAz  #  Wind Direction. Top End (ws:tpUaTeWindAz)

#[SECTION] [CP] Telescope Humidity sensor
ws:tpHsPxRh  # Telescope Relative Humidity
ws:tpHsPxTd  # Telescope Dew Point

#[SECTION] [CP] Particle monitor
ws:tpPmPxChan1    # 0.3 micron
ws:tpPmPxChan2    # 0.5 micron
ws:tpPmPxChan3    # 0.7 micron
ws:tpPmPxChan4    # 1.0 micron
ws:tpPmPxChan5    # 2.0 micron
ws:tpPmPxChan6    # 3.0 micron
ws:tpPmPxChan7    # 5.0 micron
ws:tpPmPxChan8    # 10.0 micron
ws:tpPmPxErr      {'FORMAT':'Spreadsheet'}  # Error messages
ws:tpPmPxTemp     # Temperature
ws:tpPmPxRH       # Humidity
ws:tpPmPxFlow     # Air flow lpm
ws:tpPmPxChan(.)  # All


#[SECTION] [CP] Site Monitoring
#[CSSCLASS] sectionMain

#Only show at in geasouth. Old channels -- Keep for now
#[SECTION] [CP] DIMM (seeing monitor) old channels
ws:seeFwhm              # Mean seeing (total, X & Y)
ws:seeMeanD.            # Distance between stars (X & Y)
ws:seeMeanFlux          # Mean flux  
ws:seeNimg              # Number of images taken
ws:seeR0                # Fried's parameter
ws:seeSc1t1             # Scintillation left star
ws:seeSc2t1             # Scintillation right star
ws:seeSc.t1             # Scintillation both stars
ws:seeStrlh1t.          # Strelth ratio left star (t1 & t2)
ws:seeStrlh2t.          # Strelth ratio right star (t1 & t2)
ws:seeStarName     {'FORMAT':'Spreadsheet'}     # Star name (Spreadsheet)  
ws:seeDateUT       {'FORMAT':'Spreadsheet'}     # Date & UT (Spreadsheet) 

#Only show at in geasouth.  New channels as of 10180531
#[SECTION] [CP] DIMM (seeing monitor)
ws:dimmHr               # Star Number (YBS Catalog)
ws:dimmNimg             # Number of images taken
ws:dimmFwhm             # Mean seeing (total, X & Y)
ws:dimmD.               # Distance between stars (X & Y)
ws:dimmFlux             # Mean flux
ws:dimmR0               # Fried's parameter
ws:dimmScintL           # Scintillation left star
ws:dimmScintR           # Scintillation right star
ws:dimmScint.           # Scintillation both stars
ws:dimmStrhlL           # Strehl ratio left star
ws:dimmStrhlR           # Strehl ratio right star
ws:dimmTimeUTC          {'FORMAT':'Spreadsheet'}     # Date & Time UTC (Spreadsheet) 

#[SECTION] [CP] MASS (seeing monitor)
ws:massIsop1    # Isoplanatic angle
ws:massTau      # Tau              
ws:massAirmass  # Airmass          
ws:massLayerX    # Layer X          
ws:massChi2X    # Chi square X    
ws:massJ05X     # Cn2 profile 0.5 Km
ws:massJ1X      # Cn2 profile 1 Km
ws:massJ2X      # Cn2 profile 2 Km
ws:massJ4X      # Cn2 profile 4 Km
ws:massJ8X      # Cn2 profile 8 Km
ws:massJ16X     # Cn2 profile 16 Km
ws:massFsee   {'FORMAT':'Plot'} # Mass seeing 
ws:massDate  {'FORMAT':'Spreadsheet'}  # Date(Spreadsheet)        
ws:massTime   {'FORMAT':'Spreadsheet'} # Time (Spreadsheet)         

#[SECTION] [CP] Water vapor monitor
ws:pwv                            # Precipitable water vapor

#[SECTION] [CP]  Pier Lab
ws:pltAbPl              # Air sensor 2 meters above floor  
ws:pltAbAwPl            # Air sensor 2 meters above and 3 meters away
ws:pltFlPl              # Surface sensor floor
ws:pltAbOuPl            # Air sensor outside pier lab
ws:plyng0Pressure       # Barometric pressure sensor   

#[SECTION] [CP]  Data Logger
ws:dlD1Temp1            # Temperature 1
ws:dlD1Rh1              # Relative humidity 1
ws:dlD1DewPoint1        # Dew point 1
ws:dlD1Temp2            # Temperature 2
ws:dlD1Rh2              # Relative humidity 2
ws:dlD1DewPoint2        # Dewpoint 2
ws:dlD1Press            # Atmospheric Pressure
ws:dlD1Snow             # Snow
ws:dlD1Ice              # Ice

#[SECTION] [CP]  Precipitation sensors
ws:ptAlarm1             # Precipitation sensor 1
ws:ptAlarm2             # Precipitation sensor 2
ws:ptAlarm3             # Precipitation sensor 3
ws:ptAlarm4             # Precipitation sensor 4

#[SECTION] [CP]  WFS SDSU temperatures
ws:tpAgP1            # P1WFS SDSU Temperture (Deg C)
ws:tpAgP2            # P2WFS SDSU Temperture (Deg C)
ws:tpAgHr            # HRWFS SDSU Temperture (Deg C)
ws:tpAg(P1|P2|Hr)    # All WFS SDSU Temperture (Deg C)

#[SECTION] [CP] TESTING
ws:massJ(05|1|2|4|8|16)X {'LEGEND':'Outside','CHANCONFIG':'ws:massJ05X,,,0.5km,,,,,,0.5|||ws:massJ1X,,, 1km,,,,,,1|||ws:massJ2X,,, 2km,,,,,,2|||ws:massJ4X,,, 4km,,,,,,4|||ws:massJ8X,,, 8km,,,,,,8|||ws:massJ16X,,, 16km,,,,,,16'} #Cn2 profiles (All)


#[SECTION]  IOC Stats
#[CSSCLASS] sectionMain
#[ITEMSPERROW] 4
#[SUBTABLE] True

ws:iocStats:SUSP_TASK_CNT       # Susp Tasks
ws:iocStats:MEM_FREE            # Free memory
ws:iocStats:CA_CONN_CNT         # CA Connections
ws:iocStats:APP_DIR(1|2) {'FORMAT':'Spreadsheet'} # Boot version 

ws:iocStats:GTIM_ERR_CNT        # Time errors
ws:iocStats:FD_FREE             # Free FDs
ws:iocStats:CA_CLNT_CNT         # CA Clients
ws:iocStats:UPTIME {'FORMAT':'Spreadsheet'} # Uptime

ws:iocStats:(|SYS_CPU_)LOAD     # Loads

