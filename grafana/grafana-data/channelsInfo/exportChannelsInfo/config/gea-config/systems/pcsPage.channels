#[ITEMSPERROW] 6
#[SUBTABLE] True
m1:ANB031:binOut1	# Valve 1 demand
m1:ANB035:binOut1	# Valve 2 demand
m1:ANB038:binOut1	# Valve 3 demand
m1:ANB042:binOut1	# Valve 4 demand
m1:ANB047:binOut1	# Valve 5 demand
m1:ANB050:binOut1	# Valve 6 demand
