#PCS page layout

#Defaults options for all selections for all sections:
#[ITEMSPERROW] 2
#[QUERYSTRPAIRS] {'SYSTEMS':'pcs pcsact','LEGEND':'Inside', 'GRIDLINES':'checked'}
#This below is used to control whether each section should have its own html table. 
#[SUBTABLE] False

#[SECTION] Passive Support
#[ITEMSPERROW] 3
#[SUBTABLE] True
#[CELL] X-Def
m1:MCB001:M1.(Encoder|MotDmd)	 		# Enc+Dmd
m1:MCB001:M1.PosnErr			 		# PosnErr 
#[CELL] Lat +X
m1:MCB036:M1.(Encoder|MotDmd)	 	  	# Enc+Dmd
m1:MCB036:M1.PosnErr			 		# PosnErr
#[CELL] Lat -X
m1:MCB035:M2.(Encoder|MotDmd)	 	  	# Enc+Dmd
m1:MCB035:M2.PosnErr			 		# PosnErr
#[CELL] Coarse 1
m1:MCB005:M1.(Encoder|MotDmd)	 	  	# Enc+Dmd
m1:MCB005:M1.PosnErr			 		# PosnErr
#[CELL] Coarse 2
m1:MCB006:M1.(Encoder|MotDmd)	 	  	# Enc+Dmd
m1:MCB006:M1.PosnErr			 		# PosnErr
#[CELL] Coarse 3
m1:MCB010:M1.(Encoder|MotDmd)	 	  	# Enc+Dmd
m1:MCB010:M1.PosnErr			 		# PosnErr
#[CELL] Coarse 4
m1:MCB027:M1.(Encoder|MotDmd)	 	  	# Enc+Dmd
m1:MCB027:M1.PosnErr			 		# PosnErr
#[CELL] Coarse 5
m1:MCB031:M1.(Encoder|MotDmd)	 	  	# Enc+Dmd
m1:MCB031:M1.PosnErr			 		# PosnErr
#[CELL] Coarse 6
m1:MCB032:M1.(Encoder|MotDmd)	 	  	# Enc+Dmd
m1:MCB032:M1.PosnErr			 		# PosnErr
#[CELL] Fine 1
m1:MCB005:M2.(Encoder|MotDmd)	 	  	# Enc+Dmd
m1:MCB005:M2.PosnErr			 		# PosnErr
#[CELL] Fine 2
m1:MCB006:M2.(Encoder|MotDmd)	 	  	# Enc+Dmd
m1:MCB006:M2.PosnErr			 		# PosnErr
#[CELL] Fine 3
m1:MCB010:M2.(Encoder|MotDmd)	 	  	# Enc+Dmd
m1:MCB010:M2.PosnErr			 		# PosnErr
#[CELL] Fine 4
m1:MCB027:M2.(Encoder|MotDmd)	 	  	# Enc+Dmd
m1:MCB027:M2.PosnErr			 		# PosnErr
#[CELL] Fine 5
m1:MCB031:M2.(Encoder|MotDmd)	 	  	# Enc+Dmd
m1:MCB031:M2.PosnErr			 		# PosnErr
#[CELL] Fine 6
m1:MCB032:M2.(Encoder|MotDmd)	 	  	# Enc+Dmd
m1:MCB032:M2.PosnErr			 		# PosnErr

#[CELL] All Fines
m1:MCB0(05|06|10|27|31|32):M2.Encoder            # Encoder

#[SECTION] Hydraulics
#[ITEMSPERROW] 8
#[SUBTABLE] True
#[CELL] Axial Load
m1:pss:ps:AxHydLoad.VALA            # Sector 1
m1:pss:ps:AxHydLoad.VALB            # Sector 2
m1:pss:ps:AxHydLoad.VALC            # Sector 3
m1:pss:ps:AxHydLoad.VALD            # Sector 4
m1:pss:ps:AxHydLoad.VALE            # Sector 5
m1:pss:ps:AxHydLoad.VALF            # Sector 6
m1:axialLoad            # Total

#[CELL] Axial Master Cylinder Pressures (psi)
m1:ANB090:SpareAi1            # 1
m1:ANB091:SpareAi1            # 2
m1:ANB092:SpareAi1            # 3
m1:ANB113:SpareAi1            # 4
m1:ANB114:SpareAi1            # 5
m1:ANB115:SpareAi1            # 6
m1:ANB(090|091|092|113|114|115):SpareAi1            # all

#[SECTION] 
#[CSSCLASS] 
#[ITEMSPERROW] 4
#[SUBTABLE] True
#[CELL] Lateral Master Cylinder Pressures (psi)
m1:ANB087:SpareAi1            # +X MC
m1:ANB116:SpareAi1            # -X MC
m1:ANB(087|116):SpareAi1            # All


#[SECTION]
#[CSSCLASS]
#[ITEMSPERROW] 5
#[SUBTABLE] True
#[CELL] Axial Accumulators
m1:ANB113:SpareAi2              # 1
m1:ANB117:SpareAi2              # 2
m1:ANB092:SpareAi2              # 3
m1:ANB(113|117|092):SpareAi2    # all

#[SECTION]
#[CSSCLASS]
#[ITEMSPERROW] 5
#[SUBTABLE] True
#[CELL] Lateral & X-Definer Accumulators
m1:ANB087:SpareAi2		# +X
m1:ANB116:SpareAi2		# -X
m1:ANB090:SpareAi2		# X-Definer
m1:ANB(087|116|090):SpareAi2	# all

#[CELL] X Definer Master Cylinder Pressures 
m1:ANB088:SpareAi1            # +X
m1:ANB088:SpareAi2            # -X
#[CELL]
m1:ANB088:SpareAi(1|2)        # All

