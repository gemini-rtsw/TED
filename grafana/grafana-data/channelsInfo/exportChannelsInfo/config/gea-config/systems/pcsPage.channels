#[SECTION] Control & Status (Spreadsheet - last 12 Hours)
#[ITEMSPERROW] 1
#[SUBTABLE] True
#[QUERYSTRPAIRS] {'FORMAT':'Spreadsheet', 'LAPSE':720}

m1:park.*	 																		# Park/UnPark
m1:pss(:inPosnBO|:raiseLower|:raiseLowerStatusMsg|:raiseLowerStatus|On)  	 		# PSS
m1:park(:stateNow|:lastState) 	 		# Park State
m1:aos.*           					# AO
m1:aoMoving            				# AO - number moving
m1:aoSafeCheck.F            		# Time of #moving &gt; limit
m1:cmd:(topple|quake|estop|service|overtravel|LCoverload)           				# Events/Interlocks
m1:(apssPnuLCOvld|pssHydLCOvld|pssSectorOvld|apssHydLCO:trig)(.SEVR|.VAL)           # Overloads
m1:(mcs|apss):zenithAngle&LAPSE=180            										# ZA


