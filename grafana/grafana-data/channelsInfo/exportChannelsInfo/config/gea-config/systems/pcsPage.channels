#[ITEMSPERROW] 4
#[SUBTABLE] True

m1:iocStats:SUSP_TASK_CNT       # Susp Tasks
m1:iocStats:MEM_FREE            # Free memory
m1:iocStats:(LOAD|IOC_CPU_LOAD)                # Global load
m1:iocStats:UPTIME {'FORMAT':'Spreadsheet'} # Uptime

m1:iocStats:GTIM_ERR_CNT        # Time errors
