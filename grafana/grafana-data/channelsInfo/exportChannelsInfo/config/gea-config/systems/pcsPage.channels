m1:ANB035:SpareAi1	# Valve 2 position
m1:ANB038:SpareAi1	# Valve 3 position
m1:ANB042:SpareAi1	# Valve 4 position
m1:ANB047:SpareAi1	# Valve 5 position
m1:ANB050:SpareAi1	# Valve 6 position

#[SECTION]  IOC Stats
