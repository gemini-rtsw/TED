
#PR page layout

#Defaults options for all selections for all sections:
#[ITEMSPERROW] 3
#[QUERYSTRPAIRS] {'SYSTEMS':'pr','LEGEND':'Inside', 'GRIDLINES':'checked', 'LAPSE':'180'}
#This below is used to control whether each section should have its own html table. 
#[SUBTABLE] False

#pr:pr:elec:mxapcc.VAL

#[SECTION] Plant Room Chillers
#[ITEMSPERROW] 5
#[SUBTABLE] True
#[QUERYSTRPAIRS] {'LAPSE':180}
#ec:prc3pi                               #[NA] Chiller 3 Return Pressure (psi)
#

pr:ch:(c1to|c1ti)	                # Chiller 1
pr:ch:(c2to|c2ti)	                # Chiller 2
pr:ef:(tut|out)	               		 # Tunnel Temps
pr:ef:(ef2v|ef2c)	                # Current/Voltage


#[SECTION] [CP] Hydrostatic Bearing System
#[ITEMSPERROW] 3
hbs:(oilTemp|oilTankTemp)  # Oil Tank Temperature [deg C]
hbs:oilOutTemp          # Outgoing Oil Temperature [dec C]
hbs:domeAirTemp         # Dome Temperature [deg C]
hbs:oilLevel       	# Oil Level
hbs:outPressure   	# HBS Pressure Out [bar]
hbs:flow          	# Flow Rate [LPM]
hbs:accPressure   	# Top Accumulator Pressure [bar]
hbs:botPressure         # Bottom Accumulator Pressure [bar]
hbs:(bot|acc|out)Pressure # Combined  Pressures [bar]
#[QUERYSTRPAIRS] {'FORMAT':'Spreadsheet'}
hbs:noFaults      	# No Faults

hbs:estop         	# E-Stop (1 is clear)
hbs:autoMode      	# Auto Mode
hbs:manualMode    	# Manual Mode

hbs:heartbeat     	# Heartbeat
hbs:seqStep       	# HBS Sequence Step
hbs:armed         	# Armed Status

hbs:(arm|start|stop)Out # EPICS Commands
#[CELL]
#[CELL]
hbs:faults1word
hbs:faults2word
#[CELL]
hbs:faults3word
hbs:faults4word 
#[CELL]
hbs:timeP60A            # time of P60_A top accumulator pressure below 80 bars in secs 
hbs:valP60A             # val of P60_A top accumulator pressure at time of fault 53 in bars

#[SECTION] [CP] Telescope Systems Remote Switch
#[ITEMSPERROW] 2
bfo:(summit|standby|base)Mode   # Observatory Mode 
bfo:(mcs|crcs|ecs|hbs|pin|ic|mc|az|el|loto|emo)Status  #Conditions for Transfer to Standby


#[SECTION] [CP] AHU Temperatures
#[ITEMSPERROW] 4
pr:ahu:ah2t		# AHU1
pr:ahu:ah3t		# AHU2
pr:ahu:ah4t		# AHU3
pr:ahu:ah5t		# AHU4
pr:ef:out		# Outside Temperature


#[SECTION] Troubleshooting monitoring

pr:elec:gwhRaw           #Compressor 3 Psi
pr:ahuPwrCtrlCalc
pr:ahuPwrCtrlFan
pr:ahuPwrCtrlON
pr:ahuPwrCtrlOFF
pr:ahuPwrCtrlONState
pr:ahuPwrCtrlOFFState
pr:ahuPwrCtrl(Calc|Fan|ON|OFF|ONState|OFFState) #Combined AHU graph
pr:ahuPwrState


#[SECTION]  IOC Stats
#[CSSCLASS] sectionMain
#[ITEMSPERROW] 4
#[SUBTABLE] True

pr:iocStats:SUSP_TASK_CNT       # Susp Tasks
pr:iocStats:MEM_FREE            # Free memory
pr:iocStats:LOAD                # Global load
pr:iocStats:UPTIME {'FORMAT':'Spreadsheet'} # Uptime
pr:iocStats:GTIM_ERR_CNT        # Time errors
pr:iocStats:SYS_MBUF_FREE       # Free Sys MBUFs
pr:iocStats:SYS_CLUST_AVAIL_(0|1)   # % Clust available
pr:iocStats:CA_CONN_CNT         # CA Connections
pr:iocStats:IF(I|O)_ERR_CNT     # IF errors
pr:iocStats:FD_FREE             # Free FDs
pr:iocStats:APP_DIR(1|2) {'FORMAT':'Spreadsheet'} # Boot version
pr:iocStats:CA_CLNT_CNT         # CA Clients 

