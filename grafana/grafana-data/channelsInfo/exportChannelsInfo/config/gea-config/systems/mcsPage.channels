#MCS page layout

#Defaults options for all selections for all sections:
#[ITEMSPERROW] 3
#[QUERYSTRPAIRS] {'SYSTEMS':'mcs','LEGEND':'Inside', 'GRIDLINES':'checked', 'LAPSE':'180'}
#This below is used to control whether each section should have its own html table. 
#[SUBTABLE] False

#[SECTION] Mount
#[ITEMSPERROW] 6
#[SUBTABLE] True
#[CELL] Elevation
mc:elCurrentPos  # Position
mc:elPosError  	# Error
mc:elCurrentVel		# Velocity
mc:elDemandPos  #TCS Demand
mc:inPositionEl {'FORMAT':'Spreadsheet'} #InPos Flag
#[CELL] Azimuth
mc:azCurrentPos # Position
mc:azPosError  	# Error
mc:azCurrentVel		# Velocity
mc:azDemandPos  #TCS Demand
mc:inPositionAz {'FORMAT':'Spreadsheet'} #InPos Flag

#[SECTION] MCS-TCS Demands Time Delay 
#[ITEMSPERROW] 4
#[SUBTABLE] True
mc:Tracking.VALH # TCS-MCS Network Delay

#[SECTION] PMAC Data
#[ITEMSPERROW] 3
#[SUBTABLE] True
#[CELL] Elevation
mc:elPmacDemandPos 		# PMAC Demand Position
mc:elPmacPosError 		# Error
#[CELL] Azimuth
mc:azPmacDemandPos 		# PMAC Demand Position
mc:azPmacPosError  		# Error

#[SECTION] Elevation:PMAC:Tachos
#[ITEMSPERROW] 4
#[SUBTABLE] True
mc:elTacho1     # Tacho 1
mc:elTacho2     # Tacho 2
mc:elTacho3     # Tacho 3
mc:elTacho4     # Tacho 4

#[SECTION] Azimuth:PMAC:Tachos
#[ITEMSPERROW] 4
#[SUBTABLE] True
mc:azTacho1     # Tacho 1
mc:azTacho2     # Tacho 2
mc:azTacho3     # Tacho 3
mc:azTacho4     # Tacho 4
mc:azTacho5     # Tacho 5
mc:azTacho6     # Tacho 6
mc:azTacho7     # Tacho 7
mc:azTacho8     # Tacho 8

#[SECTION] Elevation:PMAC:Currents
#[ITEMSPERROW] 4
#[SUBTABLE] True
mc:elMotor1     # Motor 1
mc:elMotor2     # Motor 2
mc:elMotor3     # Motor 3
mc:elMotor4     # Motor 4

#[SECTION] Azimuth:PMAC:Currents
#[ITEMSPERROW] 4
#[SUBTABLE] True
mc:azMotor1     # Motor 1
mc:azMotor2     # Motor 2
mc:azMotor3     # Motor 3
mc:azMotor4     # Motor 4
mc:azMotor5     # Motor 5
mc:azMotor6     # Motor 6
mc:azMotor7     # Motor 7
mc:azMotor8     # Motor 8

# [SECTION] Azimuth and Elevation
# [ITEMSPERROW] 3
# mc:az.*			#Azimuth
# mc:el(CommandS|CurrentPos|DemandPos|PmacDemandPos|PmacPosError|PosError|PosError|StateS|elmotstat1:2:|elmotstat2:2:) # Elevation
# mc:(az|el(CommandS|CurrentPos|DemandPos|PmacDemandPos|PmacPosError|PosError|PosError|StateS|elmotstat1:2:|elmotstat2:2:)).*   # Azimuth and Elevation

#[SECTION] Azimuth: Virtual Encoders: Degrees
#[ITEMSPERROW] 1
#[SUBTABLE] True
mc:azengToDeg.VALB        #   FDE
mc:azengToDeg.VALC        #   Tape Head 1
mc:azengToDeg.VALD        #   Tape Head 2
mc:azengToDeg.VALE        #   Tape Head 3
mc:azengToDeg.VALF        #   Tape Head 4
mc:azengToDeg.VALA        #   Virtual Encoder

#[SECTION] Elevation: Virtual Encoders: Degrees
#[ITEMSPERROW] 1
#[SUBTABLE] True
mc:elengToDeg.VALB     # FDE
mc:elengToDeg.VALC     # Tape Head 1
mc:elengToDeg.VALD     # Tape Head 2
mc:elengToDeg.VALA     # Virtual Encoder

#[SECTION] PMAC status words
#[ITEMSPERROW] 2
mc:elmotstat.*  # Elevation
mc:azmotstat.*	# Azimuth
mc:elmotstat1:2:OLM.MLST # Elevation Open Loop Mode
mc:azmotstat1:2:OLM.MLST # Azimuth Open Loop Mode

