trecs:sad:tSFinger	  			        # Cold Finger
trecs:sad:tSColdhead2	     			# Cold Plate
trecs:sad:tSColdhead1	     			# Cold Head
trecs:sad:tSActiveShield			    # Grating Motors
trecs:sad:tS(Detector|Finger|Coldhead2)        	# Detector, Cold Finger, Cold Plate

#[SECTION] Pressure 
trecs:sad:cryostatPressure	  		# Cryostat 

